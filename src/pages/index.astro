---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/pages/home.css';

const clients = [
  { name: 'Suryadev Alloys', sector: 'Steel', logo: '/assets/logos/clients/suryadev.png' },
  { name: 'German Steel', sector: 'Steel', logo: '/assets/logos/clients/german-steel.png' },
  { name: 'Eco-R LLP', sector: 'Mobility', logo: '/assets/logos/clients/eco-r.svg' },
  { name: 'Madhuban Hotel', sector: 'Hospitality', logo: '/assets/logos/clients/madhuban-hotel.svg' },
  { name: 'Metaroll', sector: 'Manufacturing', logo: '/assets/logos/clients/metaroll.svg' },
  { name: 'Rrajuri', sector: 'Steel', logo: '/assets/logos/clients/rrajuri.png' },
  { name: 'Bhuleshwar Seamless Private', sector: 'Seamless tubes', logo: '/assets/logos/clients/bhuleshwar.svg' },
  { name: 'Shakti Engineering', sector: 'Engineering', logo: '/assets/logos/clients/shakti-engineering.png' },
  { name: 'Meenakshi Group', sector: 'Industry', logo: '/assets/logos/clients/meenakshi-mobile.png' },
  { name: 'Samrat Group Hyderabad', sector: 'Industry', logo: '/assets/logos/clients/samrat.png' },
  { name: 'Anil Jindal World School', sector: 'Education', logo: '/assets/logos/clients/anil-jindal-school.png' },
  { name: 'Giriraj Rerolls', sector: 'Re-rolling', logo: '/assets/logos/clients/giriraj-rerolls.jpeg' },
  { name: 'KKB Group', sector: 'Industry', logo: '/assets/logos/clients/kkb-group.png' },
  { name: 'Jalna First Citizen Forum', sector: 'Civic organisation', logo: '/assets/logos/clients/jalna-first.png' },
];

const shortClientName = (name: string) => name.replace(/ (Private|Pvt Ltd|Ltd|LLP)$/, '');

const moreProducts = [
  {
    name: 'School ERP',
    category: 'Education operations',
    file: 'attendance · class 8-B',
    href: '/school-erp',
    mark: 'EDU',
    copy: 'A role-based platform that keeps teaching workflows, leadership visibility, administration, and parent communication connected.',
  },
  {
    name: 'Hotel Management',
    category: 'Hospitality operations',
    file: 'room rack · today',
    href: '/hotel-management',
    mark: 'HMS',
    copy: 'An end-to-end system for reservations, room lifecycle management, housekeeping coordination, guest service, and billing.',
  },
  {
    name: 'Restaurant Ordering',
    category: 'Food and beverage',
    file: 'kitchen display',
    href: '/restaurant-ordering',
    mark: 'POS',
    copy: 'A live order flow connecting customers, waiters, and kitchen teams without paper handoffs or fragmented updates.',
  },
  {
    name: 'Sales Tracking',
    category: 'Field operations',
    file: 'field day · 25 aug',
    href: '/sales-tracking',
    mark: 'SFA',
    copy: 'Web and mobile visibility across field visits, attendance, movement, and expenses for stronger day-to-day execution.',
  },
  {
    name: 'Carpooling App',
    category: 'Mobility',
    file: 'ride 8842',
    href: '/carpooling-app',
    mark: 'RIDE',
    copy: 'A complete mobility stack for rider bookings, driver execution, and admin-level coordination across every trip.',
  },
];
---

<MainLayout
  title="Nyx Solution — Agentic AI for WhatsApp, ERP, Tally & SAP"
  description="Nyx Solution builds agentic AI systems for WhatsApp customer operations and document-heavy ERP, TallyPrime and SAP workflows with human oversight where it matters."
>
<canvas id="bg-canvas" aria-hidden="true"></canvas>
<div class="page-shell">

<header class="hero">
  <nav class="site-nav" id="site-nav">
    <div class="container">
      <div class="nav-inner">
        <a href="/" class="brand">Nyx Solution</a>
        <ul class="nav-links">
          <li><a href="#what-we-do">Agentic AI</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/products">Products</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>
  <img class="hero-art" src="/assets/hero/home-no-text.png" alt="Industrial operations facility" fetchpriority="high" />
  <div class="container">
    <div class="hero-inner">
      <div>
        <div class="h-ey"><span class="h-ey-line"></span>Agentic AI for Business Operations</div>
        <h1 class="h1">
          <span class="hero-title-line">AI agents that move</span>
          <span class="hero-title-line"><em>operational work</em> forward.</span>
        </h1>
        <div class="h-cta">
          <a class="btn-dark" href="/contact">Book a demo</a>
          <a class="btn-ghost" href="#what-we-do">See how it works</a>
        </div>
        <div class="trust-strip">
          <span class="tp">WhatsApp · ERP · Tally · SAP</span>
          <span class="tp">Human-approved</span>
          <span class="tp">Fully traceable</span>
        </div>
      </div>
    </div>
  </div>
</header>

<section class="integrations" id="integrations" aria-labelledby="integrations-title">
  <div class="container">
    <div class="integrations-head">
      <div>
        <span class="integrations-kicker">Connected apps</span>
        <h2 id="integrations-title">Works inside the tools you already run on</h2>
      </div>
      <p>Agents move work across your finance, communication, and business systems—no rip-and-replace.</p>
    </div>

    <div class="integrations-grid">
      <div class="integration-item">
        <img class="integration-logo tally-logo" src="/assets/logos/integrations/tally.png" alt="Tally Prime" loading="eager" />
        <span>Tally Prime</span>
      </div>
      <div class="integration-item">
        <img class="integration-logo" src="/assets/logos/integrations/erp.svg" alt="" aria-hidden="true" loading="eager" />
        <span>ERP systems</span>
      </div>
      <div class="integration-item">
        <img class="integration-logo sap-logo" src="/assets/logos/integrations/sap.svg" alt="SAP" loading="eager" />
        <span>SAP</span>
      </div>
      <div class="integration-item">
        <img class="integration-logo" src="/assets/logos/integrations/whatsapp.svg" alt="WhatsApp" loading="eager" />
        <span>WhatsApp</span>
      </div>
      <div class="integration-item">
        <img class="integration-logo" src="/assets/logos/integrations/email.svg" alt="Email" loading="eager" />
        <span>Email</span>
      </div>
      <div class="integration-item">
        <img class="integration-logo workspace-logo" src="/assets/logos/integrations/google-workspace.svg" alt="Google Workspace" loading="eager" />
        <span>Google Workspace</span>
      </div>
    </div>
  </div>
</section>

<section class="cl2">
  <div class="container">
    <div class="cl2-head">
      <div class="cl2-ey"><i></i>Organisations we have worked with<i></i></div>
      <h2 class="cl2-title">Built alongside teams doing <em>real operational work</em></h2>
    </div>
  </div>

  <div class="cl2-lane" id="client-lane" aria-label="Organisations Nyx Solution has worked with">
    <div class="cl2-track">
      {[false, true].map((duplicate) => (
        <div class="cl2-set" aria-hidden={duplicate ? 'true' : undefined}>
          {clients.map((client) => (
            <button
              class="cl2-item"
              type="button"
              tabindex={duplicate ? '-1' : undefined}
              data-name={shortClientName(client.name)}
              data-sector={client.sector}
              aria-label={`${shortClientName(client.name)}, ${client.sector}`}
            >
              {client.logo ? (
                <img src={client.logo} alt={shortClientName(client.name)} loading="lazy" decoding="async" />
              ) : (
                <span class="cl2-word">{shortClientName(client.name)}</span>
              )}
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="cl2-cap" id="client-caption" aria-live="polite">
      <span><b>{clients.length} organisations</b><em class="sep">·</em><em>steel, manufacturing, education, hospitality and public institutions</em></span>
    </div>
  </div>
</section>

<main>
  <section class="section" id="what-we-do">
    <div class="container">
      <div class="sh">
        <span class="stag">How Nyx works</span>
        <h2 class="stitle rv">One intelligent layer across your business systems</h2>
        <p class="ssub rv" style="--d:80ms">Nyx brings agentic AI, the software you already use, human oversight, and responsible data controls into one coordinated operating layer.</p>
      </div>
      <div class="pillars">
        <article class="pillar pillar--dark rv" style="--d:0ms">
          <span class="pillar-label">01 · Intelligence</span>
          <h3>Agents that do the work</h3>
          <p>They read documents, apply your rules, decide the next step, and carry the job through to a finished outcome.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 148" fill="none" role="img" aria-label="Invoices, WhatsApp messages and bank lines feed into a Nyx agent, which posts most entries to Tally and holds the rest for a person.">
            <path class="wire" pathLength="1" style="--dd:.15s" d="M96 19C112 19 112 77 128 77"/><path class="wire" pathLength="1" style="--dd:.25s" d="M96 77H128"/><path class="wire" pathLength="1" style="--dd:.35s" d="M96 135C112 135 112 77 128 77"/><path class="wire" pathLength="1" style="--dd:.6s" d="M212 77C226 77 226 50 238 50"/><path class="wire" pathLength="1" style="--dd:.7s" d="M212 77C226 77 226 104 238 104"/>
            <g class="fade" style="--dd:.1s"><rect class="box" x="2" y="6" width="94" height="26" rx="8"/><text x="49" y="23">Invoice PDF</text><rect class="box" x="2" y="64" width="94" height="26" rx="8"/><text x="49" y="81">WhatsApp</text><rect class="box" x="2" y="122" width="94" height="26" rx="8"/><text x="49" y="139">Bank line</text></g>
            <g class="fade" style="--dd:.45s"><rect class="box box--core" x="128" y="51" width="84" height="52" rx="13"/><text x="170" y="81">Nyx agent</text></g>
            <g class="fade" style="--dd:.8s"><rect class="box box--posted" x="238" y="35" width="100" height="30" rx="9"/><text class="text-small text-posted" x="288" y="54">Posted to Tally</text><rect class="box box--held" x="238" y="89" width="100" height="30" rx="9"/><text class="text-small text-held" x="288" y="108">Held for you</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:60ms">
          <span class="pillar-label">02 · Connected systems</span>
          <h3>Tally, SAP and ERP, already connected</h3>
          <p>Agents read live context from the systems you already use, then write verified results back.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 118" fill="none" role="img" aria-label="Live context flows from your systems to the Nyx agent, and verified results flow back.">
            <g class="fade" style="--dd:.1s"><text class="text-label" x="60" y="10">Your systems</text><rect class="box" x="2" y="16" width="116" height="92" rx="12"/><text x="60" y="44">TallyPrime</text><text x="60" y="68">SAP</text><text x="60" y="92">ERP</text></g>
            <g class="fade" style="--dd:.2s"><text class="text-label" x="280" y="10">Nyx layer</text><rect class="box box--core" x="222" y="16" width="116" height="92" rx="12"/><text x="280" y="54">Nyx agent</text><text class="text-label" x="280" y="76">runs the steps</text></g>
            <g class="lane-read"><path class="wire" pathLength="1" style="--dd:.4s" d="M118 48H216"/><path class="wire" pathLength="1" style="--dd:.7s" d="M210 43.5 216 48l-6 4.5"/><text class="text-label" x="167" y="38">live context</text></g>
            <g class="lane-posted"><path class="wire" pathLength="1" style="--dd:.55s" d="M222 80H124"/><path class="wire" pathLength="1" style="--dd:.85s" d="M130 75.5 124 80l6 4.5"/><text class="text-label" x="170" y="98">verified result</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:120ms">
          <span class="pillar-label">03 · Oversight</span>
          <h3>Your team keeps the final say</h3>
          <p>You choose where a person approves, and exceptions route to whoever should see them.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 116" fill="none" role="img" aria-label="A run advances on its own until it reaches a checkpoint that needs your approval, then continues.">
            <path class="wire" pathLength="1" style="--dd:.15s" d="M14 76H326"/><path class="branch fade" style="--dd:.6s" d="M180 70V44"/>
            <g class="fade" style="--dd:.35s"><circle class="dot" cx="40" cy="76" r="5"/><circle class="dot" cx="110" cy="76" r="5"/><circle class="dot dot--held" cx="180" cy="76" r="5.5"/><circle class="dot" cx="250" cy="76" r="5"/><circle class="dot dot--done" cx="320" cy="76" r="5"/></g>
            <g class="fade" style="--dd:.7s"><rect class="box box--held" x="118" y="10" width="124" height="30" rx="9"/><text class="text-small text-held" x="180" y="29">Needs approval</text></g>
            <g class="fade" style="--dd:.5s"><text class="text-label" x="75" y="100">agent decides</text><text class="text-label" x="285" y="100">posts result</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:180ms">
          <span class="pillar-label">04 · Trust</span>
          <h3>Access is scoped to the task</h3>
          <p>Role-based permissions mean an agent only touches what the job in front of it needs.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 118" fill="none" role="img" aria-label="A grid of your data with only a small block lit, showing the narrow scope one task can reach.">
            <g class="fade" style="--dd:.15s">
              {Array.from({ length: 24 }, (_, index) => {
                const column = index % 8;
                const row = Math.floor(index / 8);
                const highlighted = (row === 1 || row === 2) && (column === 2 || column === 3);
                return <rect class:list={["cell", { "cell--on": highlighted }]} x={12 + column * 40} y={14 + row * 28} width="34" height="22" rx="5" />;
              })}
            </g>
            <rect class="scope fade" style="--dd:.6s" x="86" y="36" width="86" height="62" rx="10"/><text class="text-label fade" style="--dd:.9s" x="129" y="112">scope for this task</text>
          </svg>
        </article>
      </div>
    </div>
  </section>

  <section class="section prod-section" id="products">
    <div class="container">
      <div class="sh">
        <span class="stag">Agentic systems built for operations</span>
        <div class="sh-row">
          <div>
            <h2 class="stitle rv">Top workflows agents can take off your team’s plate</h2>
            <p class="ssub rv" style="--d:80ms">Practical automations for document checks, customer follow-ups, invoice delivery, and day-to-day finance work across WhatsApp, TallyPrime, SAP, and connected ERP systems.</p>
          </div>
          <a class="btn-dark rv" style="--d:100ms" href="/products">See all products</a>
        </div>
      </div>
      <div class="prod-list">

        <a href="/contact" class="prod-row rv" style="--d:0ms">
          <div class="prod-top">
            <span class="prod-num">01</span>
            <div class="prod-info"><strong>Purchase verification</strong><span>Read purchase documents, match them with orders and receipts, validate taxes and totals, flag mismatches, and prepare a clean approval packet.</span></div>
            <span class="prod-arr"><svg width="16" height="16" viewBox="0 0 17 17" fill="none"><path d="M3 8.5h11M10 5l3.5 3.5L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
          <div class="stages" aria-hidden="true">
            <div class="stage"><div class="stage-bar"><i></i></div><em>Read documents</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Match records</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Validate values</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Flag exceptions</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Approve</em></div>
          </div>
        </a>

        <a href="/contact" class="prod-row rv" style="--d:70ms">
          <div class="prod-top">
            <span class="prod-num">02</span>
            <div class="prod-info"><strong>Payment follow-ups</strong><span>Monitor open receivables and due dates, prepare clear customer reminders, send them through the right channel, and escalate overdue payments when needed.</span></div>
            <span class="prod-arr"><svg width="16" height="16" viewBox="0 0 17 17" fill="none"><path d="M3 8.5h11M10 5l3.5 3.5L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
          <div class="stages" aria-hidden="true">
            <div class="stage"><div class="stage-bar"><i></i></div><em>Find dues</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Prioritise</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Draft reminder</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Send follow-up</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Update status</em></div>
          </div>
        </a>

        <a href="/contact" class="prod-row rv" style="--d:140ms">
          <div class="prod-top">
            <span class="prod-num">03</span>
            <div class="prod-info"><strong>WhatsApp invoice automation</strong><span>Detect an eligible invoice, verify the customer and recipient, deliver the correct PDF through WhatsApp or email, prevent duplicates, and track delivery.</span></div>
            <span class="prod-arr"><svg width="16" height="16" viewBox="0 0 17 17" fill="none"><path d="M3 8.5h11M10 5l3.5 3.5L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
          <div class="stages" aria-hidden="true">
            <div class="stage"><div class="stage-bar"><i></i></div><em>Detect invoice</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Validate recipient</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Deliver PDF</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Track status</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Route help</em></div>
          </div>
        </a>

        <a href="/contact" class="prod-row rv" style="--d:210ms">
          <div class="prod-top">
            <span class="prod-num">04</span>
            <div class="prod-info"><strong>Tally automation</strong><span>Reconcile bank statements, recommend live ledgers, allocate receipts against open bills, check duplicates, and post approved vouchers back to TallyPrime.</span></div>
            <span class="prod-arr"><svg width="16" height="16" viewBox="0 0 17 17" fill="none"><path d="M3 8.5h11M10 5l3.5 3.5L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
          <div class="stages" aria-hidden="true">
            <div class="stage"><div class="stage-bar"><i></i></div><em>Import statement</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Match ledgers</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Allocate bills</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Approve</em></div>
            <div class="stage"><div class="stage-bar"><i></i></div><em>Post to Tally</em></div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <section class="section phi-section">
    <div class="container">
      <div class="phi-inner">
        <div class="phi-left">
          <span class="stag">How we build agents</span>
          <h2 class="stitle rv">Autonomy with guardrails — not black-box automation</h2>
          <p class="ssub rv" style="--d:80ms">Operational AI must know what it can decide, what it must verify, and when a person needs to approve the next action. We design all three deliberately.</p>
          <a class="btn-light rv" style="--d:150ms;margin-top:1.4rem" href="/about">How we work</a>
        </div>
        <div class="phi-right" id="phi-right">
          <div class="phi-prog" id="phi-prog"></div>
          <article class="phi-card"><div class="phi-n">01</div><h3>Understands the workflow</h3><p>The agent works from business rules, document context, roles, and the actual sequence of operational decisions.</p></article>
          <article class="phi-card"><div class="phi-n">02</div><h3>Grounded in live system data</h3><p>Recommendations are checked against current ERP, Tally, SAP, or connected business data before any action.</p></article>
          <article class="phi-card"><div class="phi-n">03</div><h3>Human approval at the right point</h3><p>Exceptions and high-impact actions reach the right person with the context needed to decide quickly.</p></article>
          <article class="phi-card"><div class="phi-n">04</div><h3>Every action is traceable</h3><p>Inputs, recommendations, approvals, system commands, and outcomes stay visible for operational control.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section class="section more-section" id="more-products">
    <div class="container">
      <div class="more-layout">
        <div class="more-copy">
          <span class="stag">Beyond Agentic AI</span>
          <h2 class="stitle rv">When the problem needs a product — not an agent — <em>we build that too</em></h2>
          <p class="ssub rv" style="--d:80ms">Agentic AI is our core focus. Alongside it, we design and engineer complete operational products shipped for daily use across education, hospitality, food service, field operations, and mobility.</p>
          <a class="more-all rv" style="--d:140ms" href="/products">See all products <span aria-hidden="true">↗</span></a>
        </div>

        <div class="more-product-list rv" aria-label="Operational products">
          {moreProducts.map((product, index) => (
            <a class="more-product-row" href={product.href}>
              <span class="more-product-num">{String(index + 1).padStart(2, '0')}</span>
              <span class="more-product-copy"><b>{product.name}</b><em>{product.category}</em><p>{product.copy}</p></span>
              <span class="more-product-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-section" id="contact">
    <div class="container">
      <a
        class="cta-inner rv"
        href="/contact"
        aria-label="Discuss an agentic workflow with Nyx Solution"
      >
        <img class="cta-image" src="/assets/images/bottom-no-text.png" alt="Operational workflows coordinated across messages and manufacturing systems" loading="lazy" decoding="async" />
        <span class="cta-copy">
          <span class="cta-title">If your ERP still depends on manual handoffs, <em>we should talk.</em></span>
          <span class="cta-button">Discuss an agentic workflow</span>
        </span>
      </a>
    </div>
  </section>
</main>

</div>
  <script is:inline src="/home.js"></script>
</MainLayout>
