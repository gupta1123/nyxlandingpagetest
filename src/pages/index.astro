---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/pages/home.css';

const clients = [
  { name: 'Suryadev Alloys', sector: 'Steel', logo: '/assets/logos/clients/suryadev.png' },
  { name: 'German Steel', sector: 'Steel', logo: '/assets/logos/clients/german-steel.png' },
  { name: 'Eco-R LLP', sector: 'Mobility', logo: '/assets/logos/clients/eco-r.svg' },
  { name: 'Madhuban Hotel', sector: 'Hospitality', logo: '/assets/logos/clients/madhuban-hotel.svg' },
  { name: 'Metaroll', sector: 'Manufacturing', logo: '/assets/logos/clients/metaroll.svg' },
  { name: 'Rrajuri', sector: 'Steel', logo: '/assets/logos/clients/rrajuri.png' },
  { name: 'Bhuleshwar Seamless Private', sector: 'Seamless tubes', logo: '/assets/logos/clients/bhuleshwar.svg' },
  { name: 'Shakti Engineering', sector: 'Engineering', logo: '/assets/logos/clients/shakti-engineering.png' },
  { name: 'Meenakshi Group', sector: 'Industry', logo: '/assets/logos/clients/meenakshi-mobile.png' },
  { name: 'Samrat Group Hyderabad', sector: 'Industry', logo: '/assets/logos/clients/samrat.png' },
  { name: 'Anil Jindal World School', sector: 'Education', logo: '/assets/logos/clients/anil-jindal-school.png' },
  { name: 'Giriraj Rerolls', sector: 'Re-rolling', logo: '/assets/logos/clients/giriraj-rerolls.jpeg' },
  { name: 'KKB Group', sector: 'Industry', logo: '/assets/logos/clients/kkb-group.png' },
  { name: 'Jalna First Citizen Forum', sector: 'Civic organisation', logo: '/assets/logos/clients/jalna-first.png' },
];

const shortClientName = (name: string) => name.replace(/ (Private|Pvt Ltd|Ltd|LLP)$/, '');

const moreProducts = [
  {
    name: 'School ERP',
    category: 'Education operations',
    file: 'attendance · class 8-B',
    href: '/school-erp',
    mark: 'EDU',
    copy: 'A role-based platform that keeps teaching workflows, leadership visibility, administration, and parent communication connected.',
  },
  {
    name: 'Hotel Management',
    category: 'Hospitality operations',
    file: 'room rack · today',
    href: '/hotel-management',
    mark: 'HMS',
    copy: 'An end-to-end system for reservations, room lifecycle management, housekeeping coordination, guest service, and billing.',
  },
  {
    name: 'Restaurant Ordering',
    category: 'Food and beverage',
    file: 'kitchen display',
    href: '/restaurant-ordering',
    mark: 'POS',
    copy: 'A live order flow connecting customers, waiters, and kitchen teams without paper handoffs or fragmented updates.',
  },
  {
    name: 'Sales Tracking',
    category: 'Field operations',
    file: 'field day · 25 aug',
    href: '/sales-tracking',
    mark: 'SFA',
    copy: 'Web and mobile visibility across field visits, attendance, movement, and expenses for stronger day-to-day execution.',
  },
  {
    name: 'Carpooling App',
    category: 'Mobility',
    file: 'ride 8842',
    href: '/carpooling-app',
    mark: 'RIDE',
    copy: 'A complete mobility stack for rider bookings, driver execution, and admin-level coordination across every trip.',
  },
];
---

<MainLayout
  title="Nyx Solution — Deployable AI Agents for TallyPrime, SAP & WhatsApp"
  description="Deploy specialized Nyx agents for document verification, bank reconciliation, collections, discount control, WhatsApp ordering, and verified actions across TallyPrime and SAP."
>
<canvas id="bg-canvas" aria-hidden="true"></canvas>
<div class="page-shell">

<header class="hero">
  <img class="hero-art" src="/assets/hero/home-no-text.png" alt="Industrial operations facility" fetchpriority="high" />
  <div class="container">
    <div class="hero-inner">
      <div>
        <div class="h-ey"><span class="h-ey-line"></span>AI agents for manufacturers &amp; distributors</div>
        <h1 class="h1">
          <span class="hero-title-line">Your finance and</span>
          <span class="hero-title-line">customer workflows,</span>
          <span class="hero-title-line"><em>executed.</em></span>
        </h1>
        <p class="h-body">Nyx agents verify documents, reconcile payments, manage discounts, and execute approved actions across TallyPrime, SAP, and WhatsApp.</p>
        <div class="h-cta">
          <a class="btn-dark" href="/contact">Book a demo</a>
          <a class="btn-ghost" href="#what-we-do">Explore the agents</a>
        </div>
      </div>
    </div>
  </div>
</header>

<section class="problem-gap" id="problem" aria-labelledby="problem-gap-title">
  <div class="container">
    <div class="problem-gap-layout">
      <div class="problem-gap-copy">
        <span class="problem-gap-kicker">The operational gap</span>
        <h2 id="problem-gap-title">Your ERP records the transaction. <em>It does not finish the workflow.</em></h2>
        <p>Purchase documents still need to be checked together. Bank receipts still need to be matched against open bills. Discounts need validation, and customer requests need answers from TallyPrime, SAP, email, and WhatsApp.</p>
      </div>

      <div class="problem-gap-list" aria-label="Where operational work still slows down">
        <article>
          <span>01</span>
          <div>
            <h3>Scattered inputs</h3>
            <p>Invoices, purchase orders, e-way bills, bank statements, email, and WhatsApp arrive separately.</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Decisions outside the system</h3>
            <p>Document mismatches, receipt allocations, discount eligibility, and exceptions still depend on manual checking.</p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Actions waiting on people</h3>
            <p>Tally vouchers, sales enquiries, invoice delivery, and payment follow-ups wait for someone to move them forward.</p>
          </div>
        </article>
      </div>
    </div>

    <div class="problem-gap-bridge">
      <span>Nyx places purpose-built agents inside this operational gap.</span>
      <i aria-hidden="true"></i>
      <a href="#what-we-do">Meet the agents <b aria-hidden="true">↓</b></a>
    </div>
  </div>
</section>

<section class="agent-deploy" id="what-we-do" aria-labelledby="agent-deploy-title">
  <div class="container">
    <div class="agent-deploy-head">
      <div>
        <span class="agent-deploy-kicker">Agents ready to deploy</span>
        <h2 id="agent-deploy-title">The work, <em>handled.</em></h2>
      </div>
      <p>Purpose-built agents read the work, check it against live business data, and execute approved actions across TallyPrime, SAP, and WhatsApp.</p>
    </div>

    <div class="agent-deploy-shell" data-agent-deploy>
      <div class="agent-deploy-stage">
        <article class="agent-deploy-panel is-active" id="agent-panel-verify" data-agent-panel="verify" data-agent-index="01">
          <div class="agent-panel-copy">
            <span class="agent-panel-label">Purchase document verification</span>
            <h3>Check purchase documents before accounting or payment.</h3>
            <p>Reads purchase and delivery documents, groups related files, and flags missing, duplicate, or mismatched details for human review.</p>
          </div>
          <div class="agent-visual agent-visual--verify" aria-label="An invoice, purchase order and receipt being matched and verified">
            <div class="agent-doc-stack" aria-hidden="true"><i></i><i></i><div><span>INV</span><b>INV-2841</b><small>Meenakshi Steel</small></div></div>
            <div class="agent-flow-line" aria-hidden="true"><i></i></div>
            <div class="agent-check-card">
              <div class="agent-card-head"><span>Purchase document check</span><small>3 documents</small></div>
              <ul>
                <li><span>Purchase order</span><b>Matched</b></li>
                <li><span>Goods receipt</span><b>Matched</b></li>
                <li class="is-review"><span>Taxable value</span><b>Review ₹1,240</b></li>
              </ul>
              <div class="agent-decision"><i></i><span>Exception prepared for approval</span></div>
            </div>
          </div>
        </article>

        <article class="agent-deploy-panel" id="agent-panel-payments" data-agent-panel="payments" data-agent-index="02">
          <div class="agent-panel-copy">
            <span class="agent-panel-label">Bank reconciliation</span>
            <h3>Reconcile bank receipts with Tally.</h3>
            <p>Matches incoming transactions to customers, ledgers, and open bills, prevents duplicates, and creates Receipt vouchers only after approval.</p>
          </div>
          <div class="agent-visual agent-visual--payments" aria-label="A bank transaction matched with invoices and posted to TallyPrime">
            <div class="agent-bank-line"><small>NEFT CREDIT</small><strong>₹4,80,000</strong><span>Shakti Steel Traders</span></div>
            <div class="agent-match-path" aria-hidden="true"><span></span><i></i><span></span></div>
            <div class="agent-ledger-card">
              <div><small>TallyPrime ledger</small><b>Shakti Steel Traders</b></div>
              <ul><li><span>INV-4471</span><b>₹3,20,000</b></li><li><span>INV-4502</span><b>₹1,60,000</b></li></ul>
              <p><i></i>Matched · ready to post</p>
            </div>
          </div>
        </article>

        <article class="agent-deploy-panel" id="agent-panel-discounts" data-agent-panel="discounts" data-agent-index="03">
          <div class="agent-panel-copy">
            <span class="agent-panel-label">Cash-discount recovery</span>
            <h3>Recover discounts that no longer qualify.</h3>
            <p>Checks payment timing against Tally terms, calculates the recoverable amount, and prepares a Debit Note for approval without duplicating a recovery.</p>
          </div>
          <div class="agent-visual agent-visual--discounts" aria-label="A customer discount entitlement being calculated and prepared as a credit note">
            <div class="agent-rule-card"><small>SCHEME RULE</small><b>2% cash discount</b><span>Payment within 10 days</span></div>
            <div class="agent-calc"><span>₹8,40,000</span><i>×</i><span>2%</span><i>=</i><strong>₹16,800</strong></div>
            <div class="agent-note-card"><small>DEBIT NOTE · DRAFT</small><b>DN-2026-0184</b><span><i></i>Recovery verified</span></div>
          </div>
        </article>

        <article class="agent-deploy-panel" id="agent-panel-customer" data-agent-panel="customer" data-agent-index="04">
          <div class="agent-panel-copy">
            <span class="agent-panel-label">Steel sales on WhatsApp</span>
            <h3>Take steel orders through WhatsApp.</h3>
            <p>Understands English, Hindi, and Hinglish, collects complete order details, confirms the request, and creates an order or sales enquiry.</p>
          </div>
          <div class="agent-visual agent-visual--customer" aria-label="A WhatsApp customer request answered using current ERP information">
            <div class="agent-chat">
              <p class="is-in">Need 25 MT of TMT 12mm delivered to Raipur next Tuesday.</p>
              <div class="agent-chat-thinking"><i></i><i></i><i></i><span>Checking customer and order details</span></div>
              <p class="is-out">Order summary ready. Confirm before I create the sales enquiry.</p>
            </div>
            <div class="agent-context-chip"><small>CUSTOMER VERIFIED</small><b>Saved delivery site · 1 item</b></div>
          </div>
        </article>

        <article class="agent-deploy-panel" id="agent-panel-sap" data-agent-panel="sap" data-agent-index="05">
          <div class="agent-panel-copy">
            <span class="agent-panel-label">SAP invoice &amp; collections</span>
            <h3>Send SAP invoices. Follow up on what’s due.</h3>
            <p>Verifies recipients, sends invoices through WhatsApp or email, prevents duplicates, and follows live receivables until payment or escalation.</p>
          </div>
          <div class="agent-visual agent-visual--sap" aria-label="SAP invoices moving through recipient validation, delivery and status updates">
            <div class="agent-sap-list">
              <div><span>9001842</span><b>Recipient verified</b></div>
              <div class="is-active"><span>9001843</span><b>Delivering PDF</b></div>
              <div><span>9001844</span><b>Duplicate prevented</b></div>
            </div>
            <div class="agent-sap-result"><span><i></i>Delivered</span><strong>WhatsApp</strong><small>Status written back to SAP</small></div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="execution-rail" id="how-it-works" aria-labelledby="execution-title">
  <div class="container">
    <div class="execution-head">
      <div>
        <span class="execution-kicker">What Nyx agents handle</span>
        <h2 id="execution-title">More than extraction. <em>They carry the work forward.</em></h2>
      </div>
      <p>Nyx agents combine unstructured inputs, live business context, company rules, and approved system actions to complete operational workflows.</p>
    </div>

    <div class="execution-capabilities">
      <article class="execution-capability">
        <span class="execution-number">01</span>
        <div class="execution-capability-mark"><i aria-hidden="true"></i><span>Documents &amp; messages</span></div>
        <h3>Inputs they understand</h3>
        <p>Purchase documents, bank statements, SAP invoices, email, and WhatsApp requests.</p>
      </article>
      <article class="execution-capability">
        <span class="execution-number">02</span>
        <div class="execution-capability-mark"><i aria-hidden="true"></i><span>Live business data</span></div>
        <h3>Context they verify</h3>
        <p>Customer ledgers, open bills, invoice references, payment allocations, scheme rules, and previous orders.</p>
      </article>
      <article class="execution-capability">
        <span class="execution-number">03</span>
        <div class="execution-capability-mark"><i aria-hidden="true"></i><span>Rules &amp; exceptions</span></div>
        <h3>Decisions they prepare</h3>
        <p>Document exceptions, receipt matches, discount recovery, order summaries, and payment follow-up priorities.</p>
      </article>
      <article class="execution-capability execution-capability--action">
        <span class="execution-number">04</span>
        <div class="execution-capability-mark"><i aria-hidden="true"></i><span>Approved system action</span></div>
        <h3>Actions they complete</h3>
        <p>Create approved Tally vouchers, raise sales enquiries, deliver verified invoices, send reminders, and record every outcome.</p>
      </article>
    </div>
  </div>
</section>

<section class="integrations" id="integrations" aria-labelledby="integrations-title">
  <div class="container">
    <div class="integrations-head">
      <div>
        <span class="integrations-kicker">Connected systems</span>
        <h2 id="integrations-title">Works inside the tools <em>you already run on.</em></h2>
      </div>
      <p>Nyx reads live context, moves verified data, and returns approved actions to the systems your team already uses.</p>
    </div>

    <div class="integration-strip" aria-label="Systems and channels supported by Nyx">
      <div class="integration-chip">
        <img class="integration-strip-logo tally-logo" src="/assets/logos/integrations/tally.png" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>TallyPrime</span><small>Ledgers, vouchers &amp; reconciliation</small></div>
      </div>
      <div class="integration-chip">
        <img class="integration-strip-logo" src="/assets/logos/integrations/erp.svg" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>ERP systems</span><small>Live records &amp; approved actions</small></div>
      </div>
      <div class="integration-chip">
        <img class="integration-strip-logo sap-logo" src="/assets/logos/integrations/sap.svg" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>SAP</span><small>Finance &amp; operational workflows</small></div>
      </div>
      <div class="integration-chip">
        <img class="integration-strip-logo" src="/assets/logos/integrations/whatsapp.svg" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>WhatsApp</span><small>Customer &amp; team actions</small></div>
      </div>
      <div class="integration-chip">
        <img class="integration-strip-logo" src="/assets/logos/integrations/email.svg" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>Email</span><small>Documents &amp; follow-ups</small></div>
      </div>
      <div class="integration-chip">
        <img class="integration-strip-logo workspace-logo" src="/assets/logos/integrations/google-workspace.svg" alt="" aria-hidden="true" />
        <div class="integration-copy"><span>Google Workspace</span><small>Shared files &amp; approvals</small></div>
      </div>
    </div>
  </div>
</section>

<section class="cl2" id="customer-proof" aria-labelledby="customer-proof-title">
  <div class="container">
    <div class="cl2-head">
      <div class="cl2-ey"><i></i>Organisations we have worked with<i></i></div>
      <h2 class="cl2-title" id="customer-proof-title">Built alongside teams doing <em>real operational work</em></h2>
      <p class="cl2-intro">Shaped around the documents, approvals, customer conversations, and system work that keep operations moving.</p>
    </div>
  </div>

  <div class="cl2-lane" id="client-lane" aria-label="Organisations Nyx Solution has worked with">
    <div class="cl2-track">
      {[false, true].map((duplicate) => (
        <div class="cl2-set" aria-hidden={duplicate ? 'true' : undefined}>
          {clients.map((client) => (
            <button
              class="cl2-item"
              type="button"
              tabindex={duplicate ? '-1' : undefined}
              data-name={shortClientName(client.name)}
              data-sector={client.sector}
              aria-label={`${shortClientName(client.name)}, ${client.sector}`}
            >
              {client.logo ? (
                <img src={client.logo} alt={shortClientName(client.name)} loading="lazy" decoding="async" />
              ) : (
                <span class="cl2-word">{shortClientName(client.name)}</span>
              )}
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="cl2-cap" id="client-caption" aria-live="polite">
      <span><b>And many more</b><em class="sep">·</em><em>Across steel, manufacturing, education, hospitality and public institutions</em></span>
    </div>
  </div>
</section>

<template data-legacy-duplicate="true">
<main>
  <section class="section" id="what-we-do">
    <div class="container">
      <div class="sh">
        <span class="stag">How Nyx works</span>
        <h2 class="stitle rv">One intelligent layer across your business systems</h2>
        <p class="ssub rv" style="--d:80ms">Nyx brings agentic AI, the software you already use, human oversight, and responsible data controls into one coordinated operating layer.</p>
      </div>
      <div class="pillars">
        <article class="pillar pillar--dark rv" style="--d:0ms">
          <span class="pillar-label">01 · Intelligence</span>
          <h3>Agents that do the work</h3>
          <p>They read documents, apply your rules, decide the next step, and carry the job through to a finished outcome.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 148" fill="none" role="img" aria-label="Invoices, WhatsApp messages and bank lines feed into a Nyx agent, which posts most entries to Tally and holds the rest for a person.">
            <path class="wire" pathLength="1" style="--dd:.15s" d="M96 19C112 19 112 77 128 77"/><path class="wire" pathLength="1" style="--dd:.25s" d="M96 77H128"/><path class="wire" pathLength="1" style="--dd:.35s" d="M96 135C112 135 112 77 128 77"/><path class="wire" pathLength="1" style="--dd:.6s" d="M212 77C226 77 226 50 238 50"/><path class="wire" pathLength="1" style="--dd:.7s" d="M212 77C226 77 226 104 238 104"/>
            <g class="fade" style="--dd:.1s"><rect class="box" x="2" y="6" width="94" height="26" rx="8"/><text x="49" y="23">Invoice PDF</text><rect class="box" x="2" y="64" width="94" height="26" rx="8"/><text x="49" y="81">WhatsApp</text><rect class="box" x="2" y="122" width="94" height="26" rx="8"/><text x="49" y="139">Bank line</text></g>
            <g class="fade" style="--dd:.45s"><rect class="box box--core" x="128" y="51" width="84" height="52" rx="13"/><text x="170" y="81">Nyx agent</text></g>
            <g class="fade" style="--dd:.8s"><rect class="box box--posted" x="238" y="35" width="100" height="30" rx="9"/><text class="text-small text-posted" x="288" y="54">Posted to Tally</text><rect class="box box--held" x="238" y="89" width="100" height="30" rx="9"/><text class="text-small text-held" x="288" y="108">Held for you</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:60ms">
          <span class="pillar-label">02 · Connected systems</span>
          <h3>Tally, SAP and ERP, already connected</h3>
          <p>Agents read live context from the systems you already use, then write verified results back.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 118" fill="none" role="img" aria-label="Live context flows from your systems to the Nyx agent, and verified results flow back.">
            <g class="fade" style="--dd:.1s"><text class="text-label" x="60" y="10">Your systems</text><rect class="box" x="2" y="16" width="116" height="92" rx="12"/><text x="60" y="44">TallyPrime</text><text x="60" y="68">SAP</text><text x="60" y="92">ERP</text></g>
            <g class="fade" style="--dd:.2s"><text class="text-label" x="280" y="10">Nyx layer</text><rect class="box box--core" x="222" y="16" width="116" height="92" rx="12"/><text x="280" y="54">Nyx agent</text><text class="text-label" x="280" y="76">runs the steps</text></g>
            <g class="lane-read"><path class="wire" pathLength="1" style="--dd:.4s" d="M118 48H216"/><path class="wire" pathLength="1" style="--dd:.7s" d="M210 43.5 216 48l-6 4.5"/><text class="text-label" x="167" y="38">live context</text></g>
            <g class="lane-posted"><path class="wire" pathLength="1" style="--dd:.55s" d="M222 80H124"/><path class="wire" pathLength="1" style="--dd:.85s" d="M130 75.5 124 80l6 4.5"/><text class="text-label" x="170" y="98">verified result</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:120ms">
          <span class="pillar-label">03 · Oversight</span>
          <h3>Your team keeps the final say</h3>
          <p>You choose where a person approves, and exceptions route to whoever should see them.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 116" fill="none" role="img" aria-label="A run advances on its own until it reaches a checkpoint that needs your approval, then continues.">
            <path class="wire" pathLength="1" style="--dd:.15s" d="M14 76H326"/><path class="branch fade" style="--dd:.6s" d="M180 70V44"/>
            <g class="fade" style="--dd:.35s"><circle class="dot" cx="40" cy="76" r="5"/><circle class="dot" cx="110" cy="76" r="5"/><circle class="dot dot--held" cx="180" cy="76" r="5.5"/><circle class="dot" cx="250" cy="76" r="5"/><circle class="dot dot--done" cx="320" cy="76" r="5"/></g>
            <g class="fade" style="--dd:.7s"><rect class="box box--held" x="118" y="10" width="124" height="30" rx="9"/><text class="text-small text-held" x="180" y="29">Needs approval</text></g>
            <g class="fade" style="--dd:.5s"><text class="text-label" x="75" y="100">agent decides</text><text class="text-label" x="285" y="100">posts result</text></g>
          </svg>
        </article>

        <article class="pillar rv" style="--d:180ms">
          <span class="pillar-label">04 · Trust</span>
          <h3>Access is scoped to the task</h3>
          <p>Role-based permissions mean an agent only touches what the job in front of it needs.</p>
          <svg class="pillar-diagram" viewBox="0 0 340 118" fill="none" role="img" aria-label="A grid of your data with only a small block lit, showing the narrow scope one task can reach.">
            <g class="fade" style="--dd:.15s">
              {Array.from({ length: 24 }, (_, index) => {
                const column = index % 8;
                const row = Math.floor(index / 8);
                const highlighted = (row === 1 || row === 2) && (column === 2 || column === 3);
                return <rect class:list={["cell", { "cell--on": highlighted }]} x={12 + column * 40} y={14 + row * 28} width="34" height="22" rx="5" />;
              })}
            </g>
            <rect class="scope fade" style="--dd:.6s" x="86" y="36" width="86" height="62" rx="10"/><text class="text-label fade" style="--dd:.9s" x="129" y="112">scope for this task</text>
          </svg>
        </article>
      </div>
    </div>
  </section>

  <section class="section prod-section" id="products">
    <div class="container">
      <div class="sh">
