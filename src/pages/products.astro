---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/pages/products.css';

// No dynamic products array needed as the user provided hardcoded HTML with specific IDs for animations.
---

<MainLayout title="Products | Nyx Solution" description="Software shaped around real operational work.">
  <div class="products-page">
    
    <!-- NAV -->
    <nav id="site-nav">
      <div class="container">
        <div class="nav-inner">
          <div style="display: flex; align-items: center; gap: 0.8rem;">
            <a href="/" class="back-link" title="Go back" aria-label="Go back" data-smart-back style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(74,58,209, 0.08); color: var(--rust); transition: all 0.2s ease;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </a>
            <a href="/" class="brand">Nyx Solution</a>
          </div>
          <ul class="nav-links">
            <li><a href="#finance-agent">AI Finance</a></li>
            <li><a href="#whatsapp-agent">WhatsApp Agent</a></li>
            <li><a href="#briefly-docs">Documents</a></li>
            <li><a href="#school-erp">School ERP</a></li>
            <li><a href="#sales-tracking">Operations</a></li>
            <li><a href="#hotel">Hospitality</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div>
            <div class="hero-eyebrow" style="opacity:0;animation:fadeUp .7s .1s both">
              <span class="ey-dot"></span>
              <span class="ey-text">Products</span>
            </div>
            <h1 class="hero-h1" style="opacity:0;animation:fadeUp .85s .2s both">
              Agentic AI for real operations.<br><em>Products for everything around it.</em>
            </h1>
            <p class="hero-lead" style="opacity:0;animation:fadeUp .75s .35s both">
              We build AI agents that understand business context, coordinate approvals, and act across WhatsApp, ERP, TallyPrime, and SAP. We also engineer complete operational products for teams that need a better system of work.
            </p>
          </div>
          <div class="hero-scroll" style="opacity:0;animation:fadeIn .7s .55s both">
            <span class="hs-label">Scroll to explore</span>
            <div class="hs-track"><div class="hs-thumb"></div></div>
          </div>
        </div>
        <div class="hero-badge" style="opacity:0;animation:fadeIn .7s .6s both">
          <span class="badge-n">10</span>
          <span class="badge-l">products</span>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="products">
      <div class="container">

        <!-- ══ 01: FINANCE OPERATIONS AGENT ══ -->
        <article class="prod" id="finance-agent">
          <div class="num-col">
            <span class="num-label">01</span>
            <div class="num-line"></div>
          </div>
          <div class="body">
            <div class="prod-header">
              <span class="prod-tag">Agentic Finance Operations</span>
            </div>
            <h2 class="prod-name">AI Bank Reconciliation &amp; Tally Posting</h2>
            <p class="prod-sub">From raw bank statements to accountant-approved entries in TallyPrime</p>
            <p class="prod-body">The agent extracts transactions, recommends live Tally ledgers, maps receipts and payments against open bills, checks duplicates, and separates confident matches from exceptions. Accountants review every proposed entry before approved vouchers are posted to TallyPrime.</p>
            <div class="prod-proof" aria-label="Companies using this workflow">
              <span>In use across</span>
              <strong>Kalika</strong>
              <strong>Gajkesari</strong>
              <strong>Polaad</strong>
            </div>
            <a href="/ai-finance-operations" class="prod-cta">
              <span>Learn More</span>
              <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="vis">
            <div class="vis-card detail-hero-preview finance-hero-preview" aria-label="Animated preview of the AI finance reconciliation workflow">
              <div class="preview-app-bar">
                <span class="preview-dots"><i></i><i></i><i></i></span>
                <span class="preview-app-name">Gajkesari <em>· reconciliation run 4129</em></span>
                <span class="preview-connection"><i></i>TallyPrime</span>
              </div>
              <div class="preview-tabs">
                <span class="on">All <b>264</b></span>
                <span>Ready <b>241</b></span>
                <span>Exceptions <b>23</b></span>
                <span>Posted <b id="finance-preview-posted">118</b></span>
              </div>
              <div class="finance-preview-body">
                <div class="finance-preview-table">
                  <div class="preview-table-head"><span>Date</span><span>Narration</span><span>Amount</span></div>
                  <div class="finance-preview-row" id="finance-preview-row-0"><span>24/08</span><span>SHAKTI STEEL TRAD</span><span>4,80,000 Cr</span></div>
                  <div class="finance-preview-row" id="finance-preview-row-1"><span>24/08</span><span>KKB GROUP · NO REF</span><span>52,300 Cr</span></div>
                  <div class="finance-preview-row" id="finance-preview-row-2"><span>24/08</span><span>SURYADEV ALLOYS</span><span>9,60,000 Dr</span></div>
                  <div class="finance-preview-row" id="finance-preview-row-3"><span>24/08</span><span>MEENAKSHI GROUP</span><span>78,200 Dr</span></div>
                </div>
                <div class="finance-preview-treatment" id="finance-preview-treatment">
                  <span class="preview-mini-title">Proposed treatment</span>
                  <dl><dt>Ledger</dt><dd id="finance-preview-ledger">Shakti Steel Traders</dd></dl>
                  <dl><dt>Voucher</dt><dd id="finance-preview-voucher">Receipt</dd></dl>
                  <dl><dt>Against</dt><dd id="finance-preview-bill">Bill 4471 · full</dd></dl>
                  <div class="finance-preview-confidence"><span>Confidence</span><i><b id="finance-preview-confidence-bar"></b></i><strong id="finance-preview-confidence-number">96%</strong></div>
                  <span class="finance-preview-approve" id="finance-preview-action">Approve</span>
                </div>
              </div>
              <div class="preview-app-foot"><span id="finance-preview-foot">Reviewing line 118 of 264</span><span>Approval required</span></div>
            </div>
          </div>
        </article>

        <!-- ══ 02: WHATSAPP OPERATIONS AGENT ══ -->
        <article class="prod alt" id="whatsapp-agent">
          <div class="num-col">
            <span class="num-label">02</span>
            <div class="num-line"></div>
          </div>
          <div class="body">
            <div class="prod-header">
              <span class="prod-tag">WhatsApp · ERP · SAP</span>
            </div>
            <h2 class="prod-name">WhatsApp Business Operations Agent</h2>
            <p class="prod-sub">Ordering, invoice delivery, status checks, and payment follow-ups in one verified conversation</p>
            <p class="prod-body">Verified customers can place steel-product orders, review pricing, check order status, and receive invoice PDFs through WhatsApp. The agent reads current SAP context before every message, routes employee approvals where required, prevents duplicate actions, and stops payment reminders automatically when the balance clears.</p>
            <p class="prod-note">SAP sales-order creation is enabled only where the required simulation, creation, and approval access is available.</p>
            <a href="/whatsapp-operations-agent" class="prod-cta">
              <span>Learn More</span>
              <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="vis">
            <div class="vis-card detail-hero-preview whatsapp-hero-preview" aria-label="Animated preview of the WhatsApp and SAP operations workflow">
              <div class="preview-app-bar">
                <span class="preview-dots"><i></i><i></i><i></i></span>
                <span class="preview-app-name">Nyx Operations <em>· WhatsApp channel</em></span>
                <span class="preview-connection"><i></i>SAP</span>
              </div>
              <div class="whatsapp-preview-body">
                <div class="whatsapp-preview-thread">
                  <div class="whatsapp-preview-head">
                    <span class="whatsapp-preview-avatar">SA</span>
                    <span><b>Rajesh · Suryadev Alloys</b><em id="whatsapp-preview-presence">online</em></span>
                  </div>
                  <div class="whatsapp-preview-messages" id="whatsapp-preview-messages"></div>
                </div>
                <div class="whatsapp-preview-rail">
                  <span class="preview-mini-title">What the agent did</span>
                  <div class="whatsapp-preview-step" id="whatsapp-preview-step-0"><i>1</i><span><b>Verified the customer</b><em>Mapped number → SAP 100482</em></span></div>
                  <div class="whatsapp-preview-step" id="whatsapp-preview-step-1"><i>2</i><span><b>Read current SAP context</b><em>Order and price state checked</em></span></div>
                  <div class="whatsapp-preview-step" id="whatsapp-preview-step-2"><i>3</i><span><b>Routed for approval</b><em>Price exception · sales head</em></span></div>
                  <div class="whatsapp-preview-step" id="whatsapp-preview-step-3"><i>4</i><span><b>Returned verified result</b><em>Customer and admin updated</em></span></div>
                </div>
              </div>
              <div class="preview-app-foot"><span id="whatsapp-preview-foot">A message is a request—not permission to act</span></div>
            </div>
          </div>
        </article>

        <!-- ══ 03: BRIEFLY DOCS  ══ -->
        <article class="prod" id="briefly-docs">
          <div class="num-col">
            <span class="num-label">03</span>
            <div class="num-line"></div>
          </div>
          <div class="body">
            <div class="prod-header">
              <div class="prod-icon"><svg viewBox="0 0 32 32" fill="none"><rect x="4" y="3" width="18" height="23" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 9h10M8 13h10M8 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="24" cy="24" r="5" fill="rgba(255,255,255,.9)" stroke="currentColor" stroke-width="1.6"/><path d="M22.5 24h3M24 22.5v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
              <span class="prod-tag">Document Intelligence</span>
            </div>
            <h2 class="prod-name">Briefly Docs</h2>
            <p class="prod-sub">Answers with proof, grounded in your documents</p>
            <p class="prod-body">Briefly Docs helps teams search across business documents, get answers grounded in source material, and handle document-heavy workflows with more confidence and speed.</p>
            <a href="/briefly-docs" class="prod-cta">
              <span>Learn More</span>
              <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="vis">
            <div class="vis-card">
              <div class="vis-briefly" id="briefly-anim">
                <div class="vb-bar">
                  <div class="vb-dot" style="background:#b3261e"></div>
                  <div class="vb-dot" style="background:#b26a00"></div>
                  <div class="vb-dot" style="background:#1f7a45"></div>
                  <span class="vb-title">Briefly Docs</span>
                </div>
                <div class="vb-search">
                  <svg width="12" height="12" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="5.5" stroke="#4a3ad1" stroke-width="1.5"/><path d="M13 13l3.5 3.5" stroke="#4a3ad1" stroke-width="1.7" stroke-linecap="round"/></svg>
                  <span class="vb-search-text" id="briefly-typed"></span>
                  <span class="vb-cursor">|</span>
                </div>
                <div class="vb-doc" id="briefly-doc">
                  <div class="vb-line" style="width:85%"></div>
                  <div class="vb-line hl" id="hl1" style="width:90%"></div>
                  <div class="vb-line" style="width:70%"></div>
                  <div class="vb-line hl" id="hl2" style="width:75%"></div>
                  <div class="vb-line" style="width:60%"></div>
                  <div class="vb-line" style="width:80%"></div>
                  <div class="vb-line" style="width:50%"></div>
                  <div class="vb-beam"></div>
                </div>
                <div class="vb-result" id="briefly-result">
                  <div class="vb-result-label">Answer found · Page 3</div>
                  <div class="vb-result-text">Employees are entitled to 18 days annual leave, accrued monthly.</div>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- ══ 04: BRIEFLY SOCIAL ══ -->
        <article class="prod alt" id="briefly-social">
          <div class="num-col">
            <span class="num-label">04</span>
            <div class="num-line"></div>
          </div>
          <div class="body">
            <div class="prod-header">
              <div class="prod-icon"><svg viewBox="0 0 32 32" fill="none"><rect x="4" y="6" width="24" height="18" rx="3" stroke="currentColor" stroke-width="1.6"></rect><path d="M9 12h14M9 16h10M9 20h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><circle cx="25" cy="9" r="2.3" fill="currentColor"></circle></svg></div>
              <span class="prod-tag">Social Content Ops</span>
            </div>
            <h2 class="prod-name">Briefly Social</h2>
            <p class="prod-sub">Create, edit, schedule, and publish social content from one workflow</p>
            <p class="prod-body">Briefly Social helps teams create posts from real brand data, reuse templates, apply AI-assisted editing, schedule publishing across connected accounts, and organize campaigns without splitting work across separate tools.</p>
            <a href="/briefly-social" class="prod-cta">
              <span>Learn More</span>
              <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="vis">
            <div class="vis-card">
              <div class="vis-social">
                <div class="bs-head">
                  <span class="bs-title">Briefly Social</span>
                  <span class="bs-sync"><span class="bs-sync-dot"></span>Brand synced</span>
                </div>
                <div class="bs-composer">
                  <div class="bs-chip-row">
                    <span class="bs-chip bs-chip-strong">Template · Product launch</span>
                    <span class="bs-chip">Instagram</span>
                    <span class="bs-chip">LinkedIn</span>
                  </div>
                  <div class="bs-post-title">Summer campaign — launch sequence</div>
                  <p class="bs-post-copy">Generate post drafts from approved product names, campaign details, offer timelines, and brand tone instead of rewriting every caption manually.</p>
                  <div class="bs-copy-lines">
                    <span style="width:92%"></span>
                    <span style="width:84%"></span>
                    <span style="width:68%"></span>
                  </div>
                </div>
                <div class="bs-grid">
                  <div class="bs-panel">
                    <div class="bs-panel-label">AI editing</div>
                    <div class="bs-panel-value">Rewrite copy, adapt visuals, keep brand voice</div>
                  </div>
                  <div class="bs-panel">
                    <div class="bs-panel-label">Scheduled</div>
                    <div class="bs-panel-value">Thu · 7:30 PM · Auto-post to connected channels</div>
                  </div>
                  <div class="bs-panel bs-panel-wide">
                    <div class="bs-panel-label">Campaign board</div>
                    <div class="bs-campaign-row">
                      <span class="bs-mini ok">12 posts planned</span>
                      <span class="bs-mini">4 approved</span>
                      <span class="bs-mini">2 live</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- ══ 05: AI PHOTOSHOOTS ══ -->
        <article class="prod" id="creative-ai">
          <div class="num-col">
            <span class="num-label">05</span>
            <div class="num-line"></div>
          </div>
          <div class="body">
            <div class="prod-header">
              <div class="prod-icon"><svg viewBox="0 0 32 32" fill="none"><rect x="3" y="8" width="26" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="17" r="4.5" stroke="currentColor" stroke-width="1.6"/><path d="M11 8l2-3h6l2 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="25" cy="13" r="1.5" fill="currentColor"/></svg></div>
              <span class="prod-tag">Creative AI</span>
            </div>
            <h2 class="prod-name">AI-Powered Photoshoots</h2>
            <p class="prod-sub">Creative production reimagined for modern brands</p>
            <p class="prod-body">Generate campaign-style brand visuals and social content with faster iteration, more flexibility, and lower production friction than traditional photoshoots — from brief to final asset in hours.</p>
            <a href="/ai-powered-photoshoots" class="prod-cta">
              <span>Learn More</span>
              <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="vis">
            <div class="vis-card" style="overflow:hidden;padding:0">
              <div id="photo-anim" style="width:100%;height:100%;display:flex;flex-direction:column">

                <div style="display:flex;border-bottom:1px solid rgba(229,229,238,.4);background:rgba(246,246,250,.6)">
                  <div class="pa-pill active" id="pa-pill-1" style="flex:1;padding:.35rem .3rem;text-align:center;font-family:'DM Mono',monospace;font-size:.55rem;font-weight:700;color:#4a3ad1;background:rgba(74,58,209,.08)">01 Upload</div>
                  <div class="pa-pill" id="pa-pill-2" style="flex:1;padding:.35rem .3rem;text-align:center;font-family:'DM Mono',monospace;font-size:.55rem;font-weight:700;color:#7c7b8c;border-left:1px solid rgba(229,229,238,.4)">02 Model</div>
                  <div class="pa-pill" id="pa-pill-3" style="flex:1;padding:.35rem .3rem;text-align:center;font-family:'DM Mono',monospace;font-size:.55rem;font-weight:700;color:#7c7b8c;border-left:1px solid rgba(229,229,238,.4)">03 Result</div>
                </div>

                <div class="pa-panel" id="pa-p1" style="flex:1;padding:.75rem;display:flex;flex-direction:column;gap:.45rem">
                  <div style="display:flex;align-items:center;gap:.55rem;background:#fff;border:1px solid rgba(229,229,238,.78);border-radius:8px;padding:.5rem .65rem;position:relative;overflow:hidden">
                    <img src="/assets/images/Dress.webp" loading="lazy" decoding="async" alt="Outfit" style="width:36px;height:46px;border-radius:5px;object-fit:cover;flex-shrink:0">
                    <div>
                      <div style="font-family:'DM Mono',monospace;font-size:.65rem;font-weight:600;color:#17161f">ivory_tank_trousers.jpg</div>
                      <div style="font-family:'DM Mono',monospace;font-size:.56rem;color:#7c7b8c;margin-top:.1rem">Analysed ✓</div>
                    </div>
                    <div id="pa-scan-beam" style="position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,rgba(74,58,209,.7),transparent);box-shadow:0 0 8px rgba(74,58,209,.4);animation:scanLine 2.8s ease-in-out infinite"></div>
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:.25rem" id="pa-tags">
                    <span class="pa-tag">Square neckline</span>
                    <span class="pa-tag">Flared trousers</span>
                    <span class="pa-tag">Ivory / taupe</span>
                    <span class="pa-tag">Smart casual</span>
                  </div>
                  <div style="display:flex;gap:.3rem;align-items:center;background:rgba(255,255,255,.5);border:1px solid rgba(229,229,238,.78);border-radius:7px;padding:.4rem .6rem">
                    <img src="/assets/images/Accessories1.webp" loading="lazy" decoding="async" alt="Heels" style="width:28px;height:28px;border-radius:4px;object-fit:cover;flex-shrink:0">
                    <img src="/assets/images/Accesories2.webp" loading="lazy" decoding="async" alt="Watch" style="width:28px;height:28px;border-radius:4px;object-fit:cover;flex-shrink:0">
                    <span style="font-family:'DM Mono',monospace;font-size:.6rem;color:#4b4a5a;flex:1">2 accessories added</span>
                    <span style="font-family:'DM Mono',monospace;font-size:.58rem;font-weight:600;background:rgba(31,122,69,.1);color:#1f7a45;border:1px solid rgba(31,122,69,.2);border-radius:999px;padding:.1rem .4rem">Ready</span>
                  </div>
                </div>

                <div class="pa-panel" id="pa-p2" style="flex:1;padding:.75rem;display:none;flex-direction:column;gap:.45rem">
                  <div style="font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:#7c7b8c;margin-bottom:.1rem">Selected model</div>
                  <div style="display:flex;align-items:center;gap:.6rem;background:#fff;border:1.5px solid #4a3ad1;border-radius:8px;padding:.55rem .7rem;box-shadow:0 0 0 3px rgba(74,58,209,.08)">
                    <img src="/assets/images/Model.webp" loading="lazy" decoding="async" alt="Model" style="width:40px;height:52px;border-radius:7px;object-fit:cover;object-position:top;flex-shrink:0">
                    <div>
                      <div style="font-size:.78rem;font-weight:700;color:#17161f">Priya · Selected ✓</div>
                      <div style="font-family:'DM Mono',monospace;font-size:.58rem;color:#7c7b8c;margin-top:.1rem;line-height:1.45">Indian skin tone · 5'7"<br>Compatible with outfit</div>
                    </div>
                  </div>
                  <div style="font-family:'DM Mono',monospace;font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#7c7b8c">Available poses</div>
                  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.32rem;flex:1">
                    <div style="border-radius:7px;overflow:hidden;border:1.5px solid #4a3ad1;box-shadow:0 0 0 2px rgba(74,58,209,.12)"><img src="/assets/images/Pose1.webp" loading="lazy" decoding="async" alt="Pose 1" style="width:100%;height:100%;object-fit:cover;object-position:top;display:block"></div>
                    <div style="border-radius:7px;overflow:hidden;border:1px solid rgba(229,229,238,.78)"><img src="/assets/images/Pose2.webp" loading="lazy" decoding="async" alt="Pose 2" style="width:100%;height:100%;object-fit:cover;object-position:top;display:block"></div>
                    <div style="border-radius:7px;overflow:hidden;border:1px solid rgba(229,229,238,.78)"><img src="/assets/images/Pose3.webp" loading="lazy" decoding="async" alt="Pose 3" style="width:100%;height:100%;object-fit:cover;object-position:top;display:block"></div>
                  </div>
                </div>

                <div class="pa-panel" id="pa-p3" style="flex:1;padding:.75rem;display:none;flex-direction:column;gap:.45rem">
                  <div style="display:flex;align-items:center;justify-content:space-between">
                    <span style="font-family:'DM Mono',monospace;font-size:.65rem;font-weight:600;color:#17161f">Campaign output</span>
                    <span id="pa-result-count" style="font-family:'DM Mono',monospace;font-size:.58rem;color:#4a3ad1">0 images</span>
                  </div>
                  <div style="display:grid;grid-template-columns:1.4fr 1fr;grid-template-rows:1fr 1fr;gap:.32rem;flex:1;min-height:140px">
