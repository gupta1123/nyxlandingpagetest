</section>

<!-- ══ CTA ══ -->
<section class="fo-cta" id="cta">
  <div class="narrow">
    <div class="fo-cta__card" id="ctaCard">
      <div class="fo-cta__glow" aria-hidden="true"></div>
      <span class="eyebrow">Get in touch</span>
      <h2>A finance workflow already shaped by real operations</h2>
      <p class="fo-cta__sub">Kalika, Gajkesari, and Polaad use this workflow to bring speed, context, and accountant control into bank reconciliation and Tally posting. We can configure the same foundation around your ledgers, rules, and approval structure.</p>
      <div class="cta-row center" style="margin-top:1.8rem">
        <a class="btn primary" href="/contact">Discuss Your Finance Workflow</a>
        <a class="btn ghost" href="/products#finance-agent">Back to Products</a>
      </div>
    </div>
  </div>
</section>

<footer><p>&copy; 2026 <strong>Nyx Solution</strong> · AI Finance Operations — TallyPrime connected</p></footer>

<script is:inline>
const $=s=>document.querySelector(s), sleep=ms=>new Promise(r=>setTimeout(r,ms));
const REDUCED=matchMedia('(prefers-reduced-motion: reduce)').matches;
addEventListener('scroll',()=>$('#mainnav').classList.toggle('scrolled',scrollY>40),{passive:true});
(()=>{const w=['Bank statement intelligence','Ledger recommendation','Bill-by-bill matching','Exception-first review','Duplicate protection','Approval and audit trail'];
$('#ticker').innerHTML=Array.from({length:3},()=>w.map(x=>`<span class="ticker-item">${x}</span>`).join('')).join('')})();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('in-view');io.unobserve(e.target)}),{threshold:.15,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.fo-apply__item,#problemCard,#ctaCard').forEach(el=>io.observe(el));
const when=(el,fn)=>{if(el)new IntersectionObserver((e,o)=>{if(e[0].isIntersecting){o.disconnect();fn()}},{threshold:.25}).observe(el)};

/* ══ HERO · the reviewer works down the queue ══ */
const HERO=[
 {row:'#h0',led:'Shakti Steel Traders',vch:'Receipt',bill:'Bill 4471 · full',amt:'₹4,80,000',conf:96,hold:false},
 {row:'#h1',led:'KKB Group',vch:'Receipt',bill:'No open bill at this amount',amt:'₹52,300',conf:38,hold:true},
 {row:'#h2',led:'Suryadev Alloys',vch:'Payment',bill:'2 bills cleared',amt:'₹9,60,000',conf:94,hold:false},
 {row:'#h3',led:'Meenakshi Group',vch:'Payment',bill:'Recurring · monthly debit',amt:'₹78,200',conf:91,hold:false}
];
(async function hero(){
  const rows=['#h0','#h1','#h2','#h3'], drw=$('#hDrw');
  if(REDUCED){drw.classList.add('show');$('#hConf').style.width='96%';$('#hConfN').textContent='96%';return}
  await sleep(800);
  let i=0, posted=118;
  while(true){
    const r=HERO[i%HERO.length];
    rows.forEach(s=>$(s).className='');
    drw.classList.remove('show');
    $('#hConf').style.width='0%'; $('#hConfN').textContent='0%';
    $('#hBtn').className='abtn pri'; $('#hBtn').textContent='Approve';
    await sleep(420);
    $(r.row).className='sel';
    $('#hFoot').textContent='Reviewing line '+(118+i)+' of 264';
    await sleep(700);
    $('#hLed').textContent=r.led; $('#hVch').textContent=r.vch;
    $('#hBill').textContent=r.bill; $('#hAmt').textContent=r.amt;
    drw.classList.add('show');
    $('#hConf').style.width=r.conf+'%';
    let n=0; const t=setInterval(()=>{n=Math.min(r.conf,n+3);$('#hConfN').textContent=n+'%';if(n>=r.conf)clearInterval(t)},26);
    await sleep(1500);
    if(r.hold){
      $('#hBtn').className='abtn pri hold'; $('#hBtn').textContent='Held';
      $(r.row).className='ex';
      $('#hFoot2').textContent='Routed to the exception queue';
      await sleep(2200);
    }else{
      $('#hBtn').className='abtn pri done'; $('#hBtn').textContent='Posted ✓';
      $(r.row).className='ok';
      posted++; $('#hPost').textContent=posted;
      $('#hFoot2').textContent='Posted to TallyPrime · voucher created';
      await sleep(1800);
    }
    $('#hFoot2').textContent='Nothing posts without approval';
    await sleep(500);
    i++;
  }
})();

/* ══ 1 · import and structure — four transaction types, source kept ══ */
when($('#p1'),async()=>{
  const ROWS=[
    ['24/08','Shakti Steel Traders','9834112','Receipt','rcpt','4,80,000 Cr'],
    ['24/08','Suryadev Alloys','000432','Payment','paym','9,60,000 Dr'],
    ['24/08','Bank charges','—','Charge','chg','1,180 Dr'],
    ['24/08','Own a/c ····9920','TRF0921','Transfer','xfer','2,00,000 Dr'],
    ['24/08','Metaroll','metaroll@ybl','Payment','paym','1,24,560 Dr'],
    ['24/08','German Steel','ICIC0456','Receipt','rcpt','11,20,000 Cr']
  ];
  const tb=$('#p1rows');
  $('#p1bar').style.width='100%';
  let pct=0; const pt=setInterval(()=>{pct=Math.min(100,pct+2);$('#p1pct').textContent=pct+'%';if(pct>=100)clearInterval(pt)},46);
  for(const [d,p,ref,type,cls,amt] of ROWS){
    const tr=document.createElement('tr'); tr.className='row';
    tr.innerHTML=`<td>${d}</td><td class="nm">${p}</td><td class="hide-s">${ref}</td>
      <td><span class="chip ${cls}">${type}</span></td><td class="num">${amt}</td>
      <td><span class="src">⤴ source</span></td>`;
    tb.appendChild(tr);
    requestAnimationFrame(()=>tr.classList.add('show'));
    await sleep(240);
    tr.querySelector('.chip').classList.add('show');
    await sleep(120);
    tr.querySelector('.src').classList.add('show');
    await sleep(160);
  }
  $('#p1conn').classList.remove('busy'); $('#p1conn').innerHTML='<i></i>Structured';
  $('#p1foot').textContent='264 rows · receipts, payments, charges and transfers separated';
});

/* ══ 2 · live lookup against the company file ══ */
when($('#p2'),async()=>{
  await sleep(500);
  for(const id of ['#l0','#l1','#l2']){ $(id).classList.add('show'); await sleep(260); }
  await sleep(500);
  $('#l0').classList.add('pick');
  $('#p2conn').classList.remove('busy'); $('#p2conn').innerHTML='<i></i>TallyPrime';
  $('#p2ts').textContent='read 12:04:06';
  await sleep(450);
  $('#p2live').textContent='fetched live';
  for(const id of ['#a0','#a1','#a2']){ $(id).classList.add('show'); await sleep(200); }
  await sleep(650);
  $('#a0').classList.add('on');
  await sleep(400);
  $('#p2tot').classList.add('show');
  $('#p2foot').textContent='Ledger, open bills and balances read from the company file at review time';
});

/* ══ 3 · the exception queue, and correcting one ══ */
when($('#p3'),async()=>{
  const EX=[
    ['KKB Group','52,300','No open bill matches this amount','38%'],
    ['Samrat Group','2,05,000','Two ledgers share this name','44%'],
    ['Shakti Engineering','95,000','Advance received · no bill yet','52%'],
    ['Giriraj Rerolls','6,15,400','Possible duplicate of voucher 4468','61%']
  ];
  await sleep(400);
  $('#t-ready').classList.remove('on'); $('#t-exc').classList.add('on');
  await sleep(450);
  const tb=$('#p3rows'); const trs=[];
  for(const [p,a,r,c] of EX){
    const tr=document.createElement('tr'); tr.className='row ex';
    tr.innerHTML=`<td class="nm">${p}</td><td class="num">${a}</td><td>${r}</td><td class="hide-s num">${c}</td>`;
    tb.appendChild(tr); trs.push(tr);
    requestAnimationFrame(()=>tr.classList.add('show'));
    await sleep(300);
  }
  await sleep(900);
  trs[1].classList.add('sel');
  $('#p3foot').textContent='Samrat Group · accountant is correcting the treatment';
  await sleep(400);
  $('#fix').classList.add('show');
  await sleep(950); $('#fixLed').classList.add('set');
  await sleep(650); $('#fixBill').classList.add('set');
  await sleep(650); $('#fixVch').classList.add('set');
  await sleep(700);
  $('#p3foot').textContent='Corrected · moves to Ready to review for approval';
});

/* ══ 4 · approval, posting, and the decision record ══ */
when($('#p4'),async()=>{
  const tb=$('#p4rows'), panel=$('#p4'), btn=$('#gBtn'), cur=$('#cur');
  const add=(t,who,act,res,cls='')=>{const tr=document.createElement('tr');tr.className='row '+cls;
    tr.innerHTML=`<td>${t}</td><td class="nm">${who}</td><td>${act}</td><td class="hide-s">${res}</td>`;
    tb.appendChild(tr);requestAnimationFrame(()=>tr.classList.add('show'))};
  await sleep(400);
  add('12:04:05','Agent','Proposed receipt · bill 4471','confidence 96%');
  await sleep(600);
  add('12:04:41','R. Kulkarni','Rejected earlier proposal','ledger corrected');
  await sleep(900);
  const host=panel.getBoundingClientRect(), br=btn.getBoundingClientRect();
  const start='translate(320px, 300px)';
  const pos=`translate(${br.left-host.left+br.width*.5}px, ${br.top-host.top+br.height*.55}px)`;
  cur.style.setProperty('--pos',start); cur.style.transform=start; cur.classList.add('on');
  await sleep(130);
  cur.style.setProperty('--pos',pos); cur.style.transform=pos;
  await sleep(980);
  btn.classList.add('hot'); await sleep(420);
  cur.classList.add('tap'); btn.classList.add('press');
  const rp=document.createElement('span'); rp.className='rip';
  rp.style.cssText='left:50%;top:50%;width:12px;height:12px'; btn.appendChild(rp);
  requestAnimationFrame(()=>rp.classList.add('go'));
  await sleep(190);
  cur.classList.remove('tap','on'); btn.classList.remove('press','hot');
  btn.classList.add('ok'); btn.textContent='Approved ✓';
  $('#gate').classList.add('done'); $('#gateT').textContent='Approved by R. Kulkarni · 12:05:41';
  add('12:05:41','R. Kulkarni','Approved receipt voucher','sent to Tally','ok');
  await sleep(800);
  $('#resp').classList.add('show');
  await sleep(600);
  add('12:05:42','TallyPrime','Voucher 4471 created','verified on read-back','ok');
});
</script>
</MainLayout>
