---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="AI Finance Operations | Nyx Solution"
  description="An agentic finance workflow that reconciles bank transactions, recommends TallyPrime ledgers, matches open bills, and posts only accountant-approved vouchers."
>
<style is:global>
:root{
  --rust-50:#fdf8ef;--rust-100:#f5ebda;--rust-200:#e9c9a8;
  --rust-300:#da956a;--rust-400:#c56f45;--rust-500:#a24a2a;
  --rust-600:#85361c;--rust-700:#6b2a14;
  --sand-50:#fff8ed;--sand-100:#f5e8d4;--sand-200:#d8c8b3;
  --ink:#1f1a16;--ink-soft:#5f5148;--ink-muted:#7a5c4c;
  --surface:#fdf8ef;--line:rgba(216,200,179,.78);--line-mid:rgba(196,160,126,.45);
  --green:#2e8c4f;--amber:#c07820;--blue:#3c5a8c;--dark-bg:#2e1f19;
  --ff-d:'Instrument Serif',Georgia,serif;--ff-b:'Sora',sans-serif;--ff-m:'DM Mono',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:radial-gradient(circle at 92% 4%,rgba(162,74,42,.13) 0,rgba(162,74,42,0) 40%),radial-gradient(circle at 6% 18%,rgba(255,226,171,.26) 0,rgba(255,226,171,0) 38%),var(--surface);color:var(--ink);font-family:var(--ff-b);font-size:16px;line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}

@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes fadeScale{from{opacity:0;transform:scale(.93)}to{opacity:1;transform:scale(1)}}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes listIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}
@keyframes stepIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(162,74,42,.55)}70%{box-shadow:0 0 0 10px rgba(162,74,42,0)}100%{box-shadow:0 0 0 0 rgba(162,74,42,0)}}
@keyframes blip{0%,100%{box-shadow:0 0 0 0 rgba(46,140,79,.45)}50%{box-shadow:0 0 0 5px rgba(46,140,79,0)}}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes glowPulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:.8;transform:scale(1.07)}}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes spin{to{transform:rotate(360deg)}}
.reveal-up{animation:fadeUp .75s cubic-bezier(.22,.85,.44,1) both}
.reveal-fade{animation:fadeScale .7s cubic-bezier(.22,.85,.44,1) both}

/* ── NAV / TICKER / LAYOUT ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:.9rem 2.8rem;background:rgba(253,248,239,.93);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);transition:padding .3s}
nav.scrolled{padding-top:.6rem;padding-bottom:.6rem}
.nav-left{display:flex;align-items:center;gap:.7rem}
.nav-back{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:rgba(255,252,244,.7);color:var(--rust-600);display:inline-flex;align-items:center;justify-content:center;transition:all .2s}
.nav-back:hover{background:var(--rust-50);border-color:var(--rust-300);transform:translateY(-1px)}
.nav-logo{font-family:var(--ff-d);font-size:1.3rem;font-style:italic;color:var(--rust-600)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{font-size:.83rem;color:var(--ink-soft);transition:color .2s}
.nav-links a:hover{color:var(--rust-500)}
.nav-cta{font-size:.83rem;font-weight:600;padding:.46rem 1.15rem;border-radius:8px;background:var(--rust-500);color:#fff;transition:all .2s}
.nav-cta:hover{background:var(--rust-600);transform:translateY(-1px)}
.ticker-wrap{margin-top:63px;overflow:hidden;background:linear-gradient(90deg,#f3e6cf,#ecd8b8);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:.5rem 0}
.ticker{display:flex;width:max-content;white-space:nowrap;animation:ticker 32s linear infinite}
.ticker-item{font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-600);padding:0 2.2rem;flex-shrink:0}
.ticker-item::after{content:'·';margin-left:2.2rem;color:var(--rust-400)}
.container{max-width:1160px;margin:0 auto;padding:0 2.4rem}
.narrow{max-width:820px;margin:0 auto;padding:0 2.4rem}
.eyebrow{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--rust-500);display:block;margin-bottom:.55rem}
.sh2{font-family:var(--ff-d);font-size:clamp(1.8rem,3.2vw,2.6rem);font-weight:400;line-height:1.18;letter-spacing:-.01em;color:var(--ink)}
.sh2 em{font-style:italic;color:var(--rust-500)}
.btn{display:inline-block;font-size:.88rem;font-weight:600;border-radius:8px;padding:.66rem 1.5rem;transition:all .2s}
.btn.primary{background:var(--rust-500);color:#fff;box-shadow:0 4px 18px rgba(162,74,42,.28)}
.btn.primary:hover{background:var(--rust-600);transform:translateY(-2px)}
.btn.ghost{border:1.5px solid var(--line-mid);color:var(--rust-600)}
.btn.ghost:hover{background:var(--rust-50);transform:translateY(-2px)}
.cta-row{display:flex;gap:.85rem;flex-wrap:wrap}
.cta-row.center{justify-content:center}

/* ══════════════════════════════════════════════════
   APP CHROME — every illustration is a real screen
══════════════════════════════════════════════════ */
.app{border:1.5px solid var(--line-mid);border-radius:14px;background:#fffdf8;overflow:hidden;box-shadow:0 26px 66px rgba(75,42,21,.14),0 3px 12px rgba(75,42,21,.06);display:flex;flex-direction:column}
.app-bar{display:flex;align-items:center;gap:.5rem;padding:.55rem .8rem;background:linear-gradient(180deg,#f7ecd8,#f2e4cd);border-bottom:1px solid var(--line)}
.app-dots{display:flex;gap:4.5px;margin-right:.2rem}
.app-dots i{width:9px;height:9px;border-radius:50%}
.app-dots i:nth-child(1){background:#f06257}.app-dots i:nth-child(2){background:#f5a623}.app-dots i:nth-child(3){background:#57c257}
.app-name{font-family:var(--ff-m);font-size:.66rem;font-weight:600;color:var(--ink)}
.app-name span{color:var(--ink-muted);font-weight:400}
.app-conn{margin-left:auto;display:flex;align-items:center;gap:.3rem;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.07em;text-transform:uppercase;color:var(--green)}
.app-conn i{width:5px;height:5px;border-radius:50%;background:var(--green);animation:blip 2s ease-in-out infinite}
.app-conn.busy{color:var(--amber)}.app-conn.busy i{background:var(--amber)}

.app-tabs{display:flex;gap:0;border-bottom:1px solid var(--line);background:#fffaf0;padding:0 .5rem}
.app-tab{padding:.42rem .65rem;font-family:var(--ff-m);font-size:.58rem;letter-spacing:.05em;color:var(--ink-muted);border-bottom:2px solid transparent;white-space:nowrap;transition:color .3s,border-color .3s}
.app-tab b{font-weight:500}
.app-tab.on{color:var(--rust-600);border-bottom-color:var(--rust-500);background:rgba(162,74,42,.04)}
.app-tab .cnt{display:inline-block;margin-left:.3rem;padding:0 .28rem;border-radius:4px;background:rgba(122,92,76,.1);font-size:.52rem}
.app-tab.on .cnt{background:rgba(162,74,42,.14);color:var(--rust-600)}
.app-tab.warn.on{color:var(--amber);border-bottom-color:var(--amber);background:rgba(192,120,32,.05)}

.app-tool{display:flex;align-items:center;gap:.4rem;padding:.4rem .7rem;border-bottom:1px solid var(--line);background:#fffdf8;font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted)}
.app-file{display:flex;align-items:center;gap:.34rem;padding:.16rem .44rem;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink)}
.app-file svg{color:var(--rust-500);flex-shrink:0}
.app-tool .r{margin-left:auto;display:flex;align-items:center;gap:.5rem}
.app-body{padding:.6rem .7rem;display:flex;flex-direction:column;gap:.5rem;flex:1;min-height:0}
.app-foot{display:flex;align-items:center;gap:.5rem;padding:.4rem .75rem;border-top:1px solid var(--line);background:#fffaf0;font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted)}
.app-foot .r{margin-left:auto}

/* generic data table */
.tbl{width:100%;border-collapse:collapse;font-family:var(--ff-m)}
.tbl th{text-align:left;font-size:.5rem;font-weight:500;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-muted);padding:.28rem .42rem;border-bottom:1px solid var(--line);background:rgba(162,74,42,.03);white-space:nowrap}
.tbl td{font-size:.6rem;color:var(--ink-soft);padding:.34rem .42rem;border-bottom:1px solid rgba(216,200,179,.5);vertical-align:middle}
.tbl tr:last-child td{border-bottom:none}
.tbl .num{text-align:right;white-space:nowrap;color:var(--ink)}
.tbl .nm{color:var(--ink);font-weight:500}
.tbl tr.row{opacity:0}
.tbl tr.row.show{animation:rise .32s cubic-bezier(.22,.85,.44,1) forwards}
.tbl tr.sel td{background:rgba(162,74,42,.09)}
.tbl tr.ok td{background:rgba(46,140,79,.05)}
.tbl tr.ex td{background:rgba(192,120,32,.07)}
.raw-cell{max-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink-muted);font-size:.55rem}

/* chips */
.chip{display:inline-flex;align-items:center;gap:.22rem;padding:.08rem .38rem;border-radius:999px;font-family:var(--ff-m);font-size:.5rem;font-weight:500;letter-spacing:.05em;white-space:nowrap;border:1px solid var(--line);color:var(--ink-muted);background:#fff;opacity:0;transition:opacity .3s}
.chip.show{opacity:1}
.chip.rcpt{border-color:rgba(46,140,79,.35);background:rgba(46,140,79,.09);color:#1c6535}
.chip.paym{border-color:rgba(162,74,42,.32);background:rgba(162,74,42,.08);color:var(--rust-600)}
.chip.chg{border-color:rgba(122,92,76,.3);background:rgba(122,92,76,.07);color:var(--ink-muted)}
.chip.xfer{border-color:rgba(60,90,140,.32);background:rgba(60,90,140,.08);color:var(--blue)}
.src{display:inline-flex;align-items:center;gap:.2rem;font-family:var(--ff-m);font-size:.5rem;color:var(--rust-500);opacity:0;transition:opacity .3s}
.src.show{opacity:.85}

/* progress */
.prog{display:flex;align-items:center;gap:.5rem;font-family:var(--ff-m);font-size:.54rem;color:var(--ink-muted)}
.prog-track{flex:1;height:4px;border-radius:99px;background:rgba(162,74,42,.1);overflow:hidden}
.prog-track i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--rust-300),var(--rust-500));transition:width 2.4s cubic-bezier(.3,.9,.3,1)}

/* ══ HERO ══ */
.fo-hero{padding:5rem 0 4rem;position:relative;isolation:isolate;overflow:hidden}
.fo-hero::before{content:'';position:absolute;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(ellipse 70% 55% at 80% 10%,rgba(162,74,42,.11),transparent),radial-gradient(ellipse 45% 55% at 5% 90%,rgba(255,215,140,.18),transparent)}
.fo-hero::after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 75% 75% at 68% 38%,black 0%,transparent 100%)}
.fo-hero__grid{display:grid;grid-template-columns:1fr 1.16fr;gap:3.2rem;align-items:center;position:relative;z-index:1}
.fo-hero__eyebrow{display:inline-flex;align-items:center;gap:.55rem;margin-bottom:.9rem}
.eyebrow-dot{width:8px;height:8px;border-radius:50%;background:var(--rust-500);animation:ping 2.2s ease-in-out infinite}
.eyebrow-text{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--rust-600)}
.fo-hero__h1{font-family:var(--ff-d);font-size:clamp(2.2rem,4.3vw,3.5rem);font-weight:400;line-height:1.08;letter-spacing:-.01em;margin-bottom:1.15rem}
.fo-hero__h1 em{font-style:italic;color:var(--rust-500)}
.fo-hero__lead{font-size:1rem;font-weight:300;color:var(--ink-soft);line-height:1.75;max-width:52ch;margin-bottom:1.8rem}
.fo-hero__demo{position:relative}
.hero-split{display:grid;grid-template-columns:1.32fr 1fr;gap:0;flex:1;min-height:0}
.hero-left{border-right:1px solid var(--line);padding-right:.55rem}
.hero-right{padding-left:.6rem;display:flex;flex-direction:column;gap:.38rem}
.drw-h{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted)}
.drw{opacity:0;transform:translateY(6px);transition:opacity .4s,transform .45s cubic-bezier(.22,.85,.44,1)}
.drw.show{opacity:1;transform:none}
.drw-row{display:flex;align-items:baseline;justify-content:space-between;gap:.5rem;font-family:var(--ff-m);font-size:.57rem;color:var(--ink-muted);padding:.16rem 0;border-bottom:1px dashed rgba(216,200,179,.55)}
.drw-row b{color:var(--ink);font-weight:500;text-align:right}
.conf{display:flex;align-items:center;gap:.4rem;margin-top:.3rem}
.conf-t{flex:1;height:4px;border-radius:99px;background:rgba(162,74,42,.1);overflow:hidden}
.conf-t i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--rust-300),var(--green));transition:width .9s cubic-bezier(.22,.85,.44,1)}
.conf b{font-family:var(--ff-m);font-size:.55rem;color:#1c6535;width:28px;text-align:right}
.drw-acts{display:flex;gap:.3rem;margin-top:auto;padding-top:.45rem}
.abtn{flex:1;text-align:center;padding:.32rem;border-radius:6px;font-family:var(--ff-m);font-size:.5rem;letter-spacing:.07em;text-transform:uppercase;border:1px solid var(--line);color:var(--ink-muted);background:#fff}
.abtn.pri{background:var(--rust-500);color:#fff;border-color:transparent;transition:background .3s}
.abtn.pri.done{background:var(--green)}
.abtn.pri.hold{background:var(--amber)}
.demo-float{position:absolute;display:flex;align-items:center;gap:.4rem;font-size:.73rem;font-weight:600;color:#5a3d2e;background:rgba(255,248,232,.95);border:1.5px solid var(--line);border-radius:999px;padding:.42rem .82rem;box-shadow:0 6px 20px rgba(75,42,21,.12);white-space:nowrap;animation:floatY 3s ease-in-out infinite}
.demo-float svg{width:13px;height:13px;flex-shrink:0}
.demo-float-1{bottom:-1rem;left:-1.6rem}
.demo-float-2{top:1rem;right:-1.6rem;animation-delay:1.4s}

/* ── STATS / OVERVIEW ── */
.stats-strip{background:var(--dark-bg);display:grid;grid-template-columns:repeat(4,1fr);gap:1px}
.stat-item{text-align:center;padding:2rem 1rem;position:relative}
.stat-item:not(:last-child)::after{content:'';position:absolute;right:0;top:25%;bottom:25%;width:1px;background:rgba(255,255,255,.07)}
.stat-text{font-family:var(--ff-m);font-size:clamp(.95rem,1.7vw,1.3rem);font-weight:500;color:var(--rust-300);display:block;line-height:1.2;margin-bottom:.3rem}
.stat-label{font-size:.7rem;color:rgba(255,255,255,.38);letter-spacing:.06em;text-transform:uppercase}
.fo-problem{padding:4rem 0}
.fo-problem__card{display:grid;grid-template-columns:auto 1fr;gap:2.2rem;align-items:start;border:1.5px solid var(--line);border-radius:24px;padding:2.6rem 2.2rem;background:linear-gradient(148deg,rgba(255,245,228,.98),rgba(250,232,198,.9));box-shadow:0 16px 48px rgba(75,42,21,.09);opacity:0}
.fo-problem__card.in-view{animation:fadeUp .8s cubic-bezier(.22,.85,.44,1) forwards}
.fo-problem-icon{color:var(--rust-500);flex-shrink:0}
.fo-problem__text h2{font-family:var(--ff-d);font-size:clamp(1.55rem,2.7vw,2.2rem);font-weight:400;line-height:1.2;margin-bottom:.9rem}
.fo-problem__text p{color:var(--ink-soft);line-height:1.72;max-width:66ch;font-weight:300}
.fo-problem__text p+p{margin-top:.7rem}

/* ── FEATURE ROWS ── */
.feat-section{padding:3rem 0 2rem}
.feat-row{display:grid;grid-template-columns:1fr 1.12fr;gap:4rem;align-items:center;padding:4.5rem 0;border-bottom:1px solid var(--line)}
.feat-row:last-child{border-bottom:none}
.feat-row.reverse .feat-copy{order:2}.feat-row.reverse .feat-illu{order:1}
.feat-num{font-family:var(--ff-m);font-size:.6rem;letter-spacing:.14em;color:var(--rust-500);opacity:.5;display:block;margin-bottom:.4rem}
.feat-copy .sh2{margin-bottom:1rem}
.feat-copy p{font-size:.95rem;font-weight:300;color:var(--ink-soft);line-height:1.75;margin-bottom:.9rem}
.bullet-list{list-style:none;display:grid;gap:.5rem;margin-top:1.1rem}
.bullet-list li{position:relative;padding-left:1.1rem;font-size:.88rem;color:var(--ink-soft)}
.bullet-list li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--rust-400)}
.feat-illu .app{min-height:352px}

/* panel 2 specifics */
.split2{display:grid;grid-template-columns:1fr 1.05fr;gap:.55rem;flex:1;min-height:0}
.sub-h{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:.28rem;display:flex;justify-content:space-between;align-items:baseline}
.sub-h em{font-style:normal;color:var(--green);font-size:.46rem}
.led{display:grid;grid-template-columns:1fr auto;gap:.4rem;align-items:center;padding:.34rem .45rem;border:1px solid var(--line);border-radius:6px;background:#fff;margin-bottom:.26rem;opacity:0;transition:opacity .3s,border-color .4s,background .4s}
.led.show{opacity:1}
.led b{display:block;font-size:.63rem;font-weight:500;color:var(--ink);line-height:1.25}
.led span{display:block;font-family:var(--ff-m);font-size:.48rem;color:var(--ink-muted)}
.led i{font-style:normal;font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted)}
.led.pick{border-color:rgba(46,140,79,.45);background:rgba(46,140,79,.06)}
.led.pick i{color:#1c6535;font-weight:600}
.alloc{display:grid;grid-template-columns:14px 1fr auto;gap:.4rem;align-items:center;padding:.3rem .4rem;border-bottom:1px dashed rgba(216,200,179,.55);font-family:var(--ff-m);font-size:.57rem;color:var(--ink-soft);opacity:0;transition:opacity .3s,background .4s}
.alloc.show{opacity:1}
.alloc.on{background:rgba(46,140,79,.07);color:#1c6535}
.box{width:12px;height:12px;border-radius:3px;border:1.5px solid var(--line-mid);position:relative;transition:all .3s}
.alloc.on .box{background:var(--green);border-color:var(--green)}
.alloc.on .box::after{content:'';position:absolute;left:3.4px;top:1.2px;width:3px;height:6px;border:solid #fff;border-width:0 1.5px 1.5px 0;transform:rotate(42deg)}
.alloc-tot{display:flex;justify-content:space-between;padding:.36rem .4rem 0;margin-top:.24rem;border-top:1px solid var(--line);font-family:var(--ff-m);font-size:.57rem;color:var(--ink-muted)}
.alloc-tot b{color:#1c6535;font-weight:600;opacity:0;transition:opacity .4s}
.alloc-tot b.show{opacity:1}

/* panel 3 correction drawer */
.fix{margin-top:.3rem;border:1px solid rgba(192,120,32,.4);border-radius:8px;background:#fffaf0;padding:.5rem .55rem;max-height:0;opacity:0;overflow:hidden;transition:max-height .5s cubic-bezier(.22,.85,.44,1),opacity .35s,margin-top .4s,padding .4s}
.fix.show{max-height:120px;opacity:1}
.fix-h{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);margin-bottom:.35rem}
.fix-r{display:grid;grid-template-columns:66px 1fr;gap:.45rem;align-items:center;margin-bottom:.28rem}
.fix-r label{font-family:var(--ff-m);font-size:.52rem;color:var(--ink-muted)}
.sel{display:flex;align-items:center;justify-content:space-between;gap:.4rem;padding:.24rem .42rem;border:1px solid var(--line);border-radius:5px;background:#fff;font-family:var(--ff-m);font-size:.56rem;color:var(--ink);transition:border-color .3s,background .3s}
.sel.set{border-color:rgba(46,140,79,.45);background:rgba(46,140,79,.05)}
.sel s{text-decoration:none;color:var(--ink-muted);font-size:.5rem}

/* panel 4 */
.vpre{border:1px solid var(--line);border-radius:8px;background:#fff;padding:.55rem .6rem}
.vpre-h{display:flex;align-items:baseline;justify-content:space-between;gap:.5rem;padding-bottom:.34rem;border-bottom:1px solid var(--line);margin-bottom:.34rem}
.vpre-h b{font-size:.7rem;font-weight:600}
.vpre-h span{font-family:var(--ff-m);font-size:.52rem;color:var(--ink-muted)}
.vpre-l{display:grid;grid-template-columns:20px 1fr auto;gap:.45rem;font-family:var(--ff-m);font-size:.6rem;color:var(--ink-soft);padding:.12rem 0}
.vpre-l em{font-style:normal;color:var(--rust-600);font-weight:500}
.vpre-l b{color:var(--ink);font-weight:500}
.vpre-r{margin-top:.32rem;padding-top:.32rem;border-top:1px dashed var(--line);font-family:var(--ff-m);font-size:.52rem;color:var(--ink-muted)}
