---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Careers at Nyx Solution — Build Agentic AI Systems"
  description="Join Nyx Solution to build production agentic AI systems for ERP, TallyPrime, SAP, and complex business operations. Now hiring frontend and backend developers with 2–3 years of experience."
>
<style is:global>
.careers-page{
  --ink:#1f1a16;--soft:#66574e;--muted:#9c8880;
  --rust:#a24a2a;--rust-dk:#85361c;--rust-lt:#c56f45;
  --ivory:#fdf8ef;--cream:#fffdf8;--line:rgba(185,165,150,.42);
  --green:#2e8c4f;--amber:#c07820;--blue:#3c5a8c;
  --fe:#3c5a8c;--be:#a24a2a;
  --ff-d:'Instrument Serif',Georgia,serif;--ff-b:'Sora',sans-serif;--ff-m:'DM Mono',monospace;
  min-height:100vh;color:var(--ink);font-family:var(--ff-b);line-height:1.65;
  background:radial-gradient(circle at 92% 4%,rgba(162,74,42,.12),transparent 34%),var(--ivory);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{margin:0}
.careers-page a{text-decoration:none;color:inherit}
.careers-page ul{list-style:none}
.cc{width:min(1140px,calc(100vw - 3rem));margin:0 auto}

@keyframes cUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes cRise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes cPing{0%{box-shadow:0 0 0 0 rgba(162,74,42,.5)}70%{box-shadow:0 0 0 9px rgba(162,74,42,0)}100%{box-shadow:0 0 0 0 rgba(162,74,42,0)}}
@keyframes cSpin{to{transform:rotate(360deg)}}
.rv{opacity:0}.rv.in{animation:cUp .7s cubic-bezier(.22,.85,.44,1) both}

/* ── nav ── */
.c-nav{position:sticky;top:0;z-index:50;background:rgba(253,248,239,.9);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)}
.c-nav-in{min-height:62px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem}
.c-brand{font-family:var(--ff-d);font-size:1.32rem}
.c-links{display:flex;align-items:center;gap:2rem}
.c-links a,.c-nav-cta{font-family:var(--ff-m);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--soft);transition:color .2s}
.c-links a:hover,.c-links a.active{color:var(--rust)}
.careers-page .c-nav-cta{justify-self:end;padding:.55rem 1rem;color:var(--cream);background:var(--ink);border-radius:999px}
.c-nav-cta:hover{background:var(--rust-dk)}

/* ── hero ── */
.c-hero{padding:clamp(3rem,6vw,5rem) 0 2.4rem}
.c-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);align-items:center;gap:clamp(2rem,5vw,4rem)}
.c-ey,.c-kick{font-family:var(--ff-m);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:var(--rust)}
.c-ey{display:flex;align-items:center;gap:.65rem;margin-bottom:1.1rem}
.c-ey i{width:26px;height:1px;background:var(--rust)}
.c-hero h1{max-width:13ch;font-family:var(--ff-d);font-size:clamp(2.6rem,5.4vw,4.4rem);font-weight:400;line-height:1;letter-spacing:-.03em}
.c-hero h1 em{font-style:italic;color:var(--rust)}
.c-lead{max-width:52ch;margin-top:1.15rem;font-size:.95rem;font-weight:300;line-height:1.78;color:var(--soft)}
.c-acts{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}
.c-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 1.15rem;border:1px solid var(--ink);border-radius:4px;font-size:.76rem;font-weight:600;transition:transform .2s,background .2s,color .2s}
.c-btn:hover{transform:translateY(-2px)}
.careers-page .c-btn-p{color:var(--cream);background:var(--ink)}
.c-btn-p:hover{background:var(--rust-dk)}
.c-btn-s:hover{color:var(--rust);border-color:var(--rust)}

/* Homepage-style interview image treatment */
.career-visual{position:relative;isolation:isolate;aspect-ratio:3/2;overflow:hidden;border:1.5px solid rgba(196,160,126,.45);border-radius:14px;background:#281c16;box-shadow:0 24px 60px rgba(81,50,33,.18)}
.career-visual>img{position:absolute;inset:-8px;z-index:0;width:calc(100% + 16px);height:calc(100% + 16px);object-fit:cover;filter:blur(2.75px) saturate(.9) contrast(.96);transform:scale(1.025)}
.career-visual::after{content:'';position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse 72% 76% at 50% 52%,rgba(15,10,7,.7) 0%,rgba(15,10,7,.5) 42%,rgba(15,10,7,.2) 74%,rgba(15,10,7,.08) 100%),linear-gradient(180deg,rgba(15,10,7,.2),rgba(15,10,7,.38));pointer-events:none}
.career-visual-copy{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(1.5rem,4vw,3rem);text-align:center;color:#fffaf1;text-shadow:0 3px 24px rgba(10,6,4,.42)}
.career-visual-kicker{display:flex;align-items:center;gap:.55rem;margin-bottom:.85rem;font-family:var(--ff-m);font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:#efb184}
.career-visual-kicker::before,.career-visual-kicker::after{content:'';width:22px;height:1px;background:#efb184}
.career-visual-copy h2{max-width:11ch;font-family:var(--ff-d);font-size:clamp(1.9rem,3.5vw,3.15rem);font-weight:400;line-height:1.02;letter-spacing:-.025em}
.career-visual-copy h2 em{font-style:italic;color:#f0a06b}
.career-visual-copy p:last-child{max-width:38ch;margin-top:.85rem;font-size:.76rem;font-weight:300;line-height:1.65;color:rgba(255,250,241,.88)}

/* ══ HERO ILLUSTRATION — a pull request ══
   The artifact every engineer reads without explanation:
   what changed, what the checks said, who reviewed it,
   and whether it shipped. */
.pr{border:1.5px solid rgba(196,160,126,.45);border-radius:14px;background:#fffdf8;overflow:hidden;box-shadow:0 24px 60px rgba(81,50,33,.13);position:relative}
.pr-bar{display:flex;align-items:center;gap:.45rem;padding:.48rem .75rem;background:linear-gradient(180deg,#f7ecd8,#f2e4cd);border-bottom:1px solid var(--line);font-family:var(--ff-m);font-size:.6rem;color:var(--soft)}
.pr-bar b{color:var(--ink);font-weight:600}
.pr-bar .r{margin-left:auto;display:flex;align-items:center;gap:.35rem}
.pr-state{display:inline-flex;align-items:center;gap:.3rem;padding:.12rem .45rem;border-radius:999px;font-size:.52rem;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(192,120,32,.35);background:rgba(192,120,32,.1);color:var(--amber);transition:all .4s}
.pr-state.merged{border-color:rgba(162,74,42,.3);background:rgba(162,74,42,.1);color:var(--rust)}
.pr-body{padding:.7rem .8rem;display:flex;flex-direction:column;gap:.6rem}
.pr-title{font-size:.92rem;font-weight:600;line-height:1.35}
.pr-branch{display:flex;align-items:center;gap:.4rem;margin-top:.25rem;font-family:var(--ff-m);font-size:.55rem;color:var(--muted);flex-wrap:wrap}
.pr-branch code{padding:.06rem .32rem;border-radius:4px;background:rgba(162,74,42,.07);color:var(--rust-dk)}
.pr-who{display:inline-flex;align-items:center;gap:.35rem;margin-left:auto}
.pr-av{width:16px;height:16px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(140deg,#c05f34,#7d3a1c);font-family:var(--ff-m);font-size:.42rem;font-weight:600;color:#ffeede}

.pr-sec{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.3rem}
.pr-file{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:.5rem;padding:.26rem .45rem;border-radius:6px;font-family:var(--ff-m);font-size:.58rem;color:var(--soft);opacity:0;transform:translateY(6px)}
.pr-file.show{animation:cRise .32s cubic-bezier(.22,.85,.44,1) forwards}
.pr-file:nth-child(odd){background:rgba(162,74,42,.028)}
.pr-file .add{color:var(--green);font-size:.52rem}
.pr-file .del{color:#a2422a;font-size:.52rem}

.pr-check{display:grid;grid-template-columns:15px 1fr auto;align-items:center;gap:.5rem;padding:.24rem .45rem;font-size:.66rem;color:var(--soft);opacity:0}
.pr-check.show{animation:cRise .3s ease forwards}
.pr-check .ic{width:13px;height:13px;border-radius:50%;border:1.5px solid var(--line);background:#fff;display:grid;place-items:center;font-size:.4rem;color:transparent;transition:all .3s}
.pr-check.run .ic{border-color:var(--rust-lt);border-right-color:transparent;animation:cSpin .7s linear infinite}
.pr-check.pass .ic{background:var(--green);border-color:var(--green);color:#fff}
.pr-check.wait .ic{background:rgba(192,120,32,.15);border-color:var(--amber);color:var(--amber)}
.pr-check em{font-style:normal;font-family:var(--ff-m);font-size:.52rem;color:var(--muted);transition:color .3s}
.pr-check.pass em{color:#2e8c4f}
.pr-check.wait em{color:var(--amber)}

.pr-note{display:grid;grid-template-columns:20px 1fr;gap:.5rem;padding:.5rem .55rem;border:1px solid var(--line);border-radius:9px;background:rgba(255,253,248,.9);opacity:0;transform:translateY(7px);transition:opacity .4s,transform .45s cubic-bezier(.22,.85,.44,1),border-color .4s,background .4s}
.pr-note.show{opacity:1;transform:none}
.pr-note.approved{border-color:rgba(46,140,79,.35);background:rgba(46,140,79,.05)}
.pr-note .pr-av{width:20px;height:20px;font-size:.46rem;background:linear-gradient(140deg,#5d7c9e,#33465e)}
.pr-note b{display:block;font-size:.65rem;font-weight:600}
.pr-note b s{text-decoration:none;font-family:var(--ff-m);font-size:.5rem;font-weight:400;color:var(--muted);margin-left:.4rem}
.pr-note p{margin-top:.15rem;font-size:.72rem;font-weight:300;line-height:1.5;color:var(--soft)}

.pr-foot{display:flex;align-items:center;gap:.6rem;padding:.55rem .8rem;border-top:1px solid var(--line);background:#fffaf0}
.pr-msg{font-family:var(--ff-m);font-size:.55rem;color:var(--muted);transition:color .4s}
.pr-msg.ok{color:#2e8c4f}
.pr-merge{position:relative;overflow:hidden;margin-left:auto;padding:.34rem .8rem;border-radius:6px;background:rgba(162,74,42,.25);color:#fff;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:background .35s,transform .2s cubic-bezier(.34,1.5,.64,1),box-shadow .2s}
.pr-merge.live{background:var(--rust)}
.pr-merge.hot{transform:translateY(-2px);box-shadow:0 6px 14px rgba(162,74,42,.3)}
.pr-merge.done{background:var(--green)}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.6);transform:translate(-50%,-50%) scale(0);pointer-events:none}
.rip.go{animation:crp .5s ease-out forwards}
@keyframes crp{to{transform:translate(-50%,-50%) scale(12);opacity:0}}
.cursor{position:absolute;width:15px;height:15px;z-index:20;opacity:0;pointer-events:none;filter:drop-shadow(0 3px 6px rgba(60,38,18,.4));transition:transform .85s cubic-bezier(.33,.9,.28,1),opacity .3s}
.cursor.on{opacity:1}
.cursor.tap{transform:var(--pos) scale(.85)!important;transition:transform .1s ease}

/* ── hiring strip (was a large aside) ── */
.hire{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.6rem;margin-top:2.2rem;padding:.85rem 1.1rem;border:1px solid var(--line);border-radius:12px;background:rgba(255,253,248,.75)}
.hire-live{display:inline-flex;align-items:center;gap:.45rem;font-family:var(--ff-m);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--rust)}
.hire-live i{width:7px;height:7px;border-radius:50%;background:var(--rust);animation:cPing 2.2s ease-in-out infinite}
.hire-n{font-family:var(--ff-d);font-size:2rem;line-height:1;letter-spacing:-.02em}
.hire-n em{font-style:normal;font-family:var(--ff-b);font-size:.78rem;font-weight:400;color:var(--soft);margin-left:.45rem}
.hire-roles{margin-left:auto;display:flex;gap:.5rem;flex-wrap:wrap}
.hire-chip{display:inline-flex;align-items:center;gap:.5rem;padding:.34rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--cream);font-size:.76rem;transition:border-color .2s,transform .2s}
.hire-chip:hover{border-color:var(--rust);transform:translateY(-1px)}
.hire-chip b{font-family:var(--ff-m);font-size:.55rem;letter-spacing:.04em;color:var(--rust);font-weight:500}

/* ── why · compact cards with drawn glyphs ── */
.why{padding:clamp(3.2rem,6vw,4.5rem) 0;border-top:1px solid var(--line)}
.head{max-width:640px}
.head h2{margin-top:.6rem;font-family:var(--ff-d);font-size:clamp(1.9rem,3.6vw,2.9rem);font-weight:400;line-height:1.08;letter-spacing:-.02em}
.head>p{max-width:58ch;margin-top:.85rem;font-size:.92rem;font-weight:300;line-height:1.75;color:var(--soft)}
.bgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:2.2rem;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.bcard{background:rgba(255,253,248,.55);padding:1.25rem 1.2rem;transition:background .25s}
.bcard:hover{background:var(--cream)}
.bcard-top{display:flex;align-items:center;justify-content:space-between;gap:.6rem}
.bnum{font-family:var(--ff-m);font-size:.58rem;letter-spacing:.1em;color:var(--rust);opacity:.6}
.glyph{width:46px;height:26px}
.glyph path,.glyph rect,.glyph circle,.glyph line{stroke-dasharray:var(--l,60);stroke-dashoffset:var(--l,60);transition:stroke-dashoffset .9s cubic-bezier(.22,1,.36,1) var(--d,0ms)}
.bcard.in .glyph path,.bcard.in .glyph rect,.bcard.in .glyph circle,.bcard.in .glyph line{stroke-dashoffset:0}
.bcard h3{margin-top:.85rem;font-family:var(--ff-d);font-size:1.28rem;font-weight:400;line-height:1.2}
.bcard p{margin-top:.4rem;font-size:.82rem;font-weight:300;line-height:1.68;color:var(--soft)}

/* ── roles · a switcher, not two slabs ── */
.roles{padding:clamp(3.2rem,6vw,4.5rem) 0;color:#f9eddb;background:#241b17}
.roles .c-kick{color:#d98b6b}
.roles .head h2{color:#fff7e8}
.roles .head>p{color:rgba(255,240,220,.6)}
.rswitch{display:grid;grid-template-columns:.78fr 1.22fr;gap:1.1rem;margin-top:2.2rem;align-items:start}
.rpick{display:flex;flex-direction:column;gap:.5rem}
.rtab{position:relative;text-align:left;padding:.95rem 1rem;border:1px solid rgba(255,240,210,.13);border-radius:12px;background:rgba(255,255,255,.025);cursor:pointer;font-family:inherit;color:inherit;transition:background .3s,border-color .3s,transform .3s}
.rtab:hover{background:rgba(255,255,255,.05)}
.rtab.on{background:rgba(217,139,107,.1);border-color:rgba(217,139,107,.42);transform:translateX(3px)}
.rtab::before{content:'';position:absolute;left:0;top:14%;bottom:14%;width:2px;border-radius:2px;background:#d98b6b;transform:scaleY(0);transition:transform .35s}
.rtab.on::before{transform:scaleY(1)}
.rtab-top{display:flex;align-items:center;justify-content:space-between;gap:.7rem;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.11em;text-transform:uppercase;color:#d98b6b}
.rtab-top s{text-decoration:none;color:rgba(255,240,220,.4)}
.rtab h3{margin-top:.5rem;font-family:var(--ff-d);font-size:1.55rem;font-weight:400;line-height:1.1;color:#fff7e8}
.rtab p{margin-top:.3rem;font-size:.78rem;font-weight:300;line-height:1.55;color:rgba(255,240,220,.55)}
.rtab .exp{display:inline-block;margin-top:.6rem;padding:.2rem .5rem;border:1px solid rgba(217,139,107,.35);border-radius:999px;font-family:var(--ff-m);font-size:.53rem;letter-spacing:.05em;text-transform:uppercase;color:#e9a98e}

.rpanel{position:relative;min-height:326px;border:1px solid rgba(255,240,210,.13);border-radius:12px;background:rgba(255,255,255,.025);padding:1.3rem 1.4rem}
.rview{position:absolute;inset:1.3rem 1.4rem;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .35s,transform .45s cubic-bezier(.22,.85,.44,1);display:flex;flex-direction:column}
.rview.on{opacity:1;transform:none;pointer-events:auto}
.rview-h{display:flex;align-items:baseline;justify-content:space-between;gap:.8rem;padding-bottom:.7rem;border-bottom:1px solid rgba(255,240,210,.12)}
.rview-h b{font-family:var(--ff-d);font-size:1.35rem;font-weight:400;color:#fff7e8}
.rview-h span{font-family:var(--ff-m);font-size:.53rem;letter-spacing:.08em;color:rgba(255,240,220,.45)}
.rcols{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;padding-top:.9rem;flex:1}
.rcols h4{margin-bottom:.6rem;font-family:var(--ff-m);font-size:.56rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:#d98b6b}
.rcols li{position:relative;padding-left:.9rem;margin-bottom:.5rem;font-size:.76rem;line-height:1.6;color:rgba(255,240,220,.68);opacity:0}
.rview.on .rcols li{animation:cRise .38s cubic-bezier(.22,.85,.44,1) forwards}
.rview.on .rcols li:nth-child(2){animation-delay:.06s}
.rview.on .rcols li:nth-child(3){animation-delay:.12s}
.rview.on .rcols li:nth-child(4){animation-delay:.18s}
.rcols li::before{content:'';position:absolute;top:.6em;left:0;width:4px;height:4px;border-radius:50%;background:#d98b6b}
.rapply{display:inline-flex;align-items:center;gap:.55rem;margin-top:auto;padding-top:.9rem;font-size:.78rem;font-weight:600;color:#fff7e8}
.rapply s{text-decoration:none;color:#d98b6b;transition:transform .2s}
.rapply:hover s{transform:translate(3px,-3px)}

/* ── apply ── */
.apply{padding:3.2rem 0}
.apply-card{display:grid;grid-template-columns:1.2fr .8fr;align-items:end;gap:2.5rem;padding:clamp(1.5rem,3.5vw,2.4rem);border:1px solid var(--line);border-radius:16px;background:var(--cream)}
.apply-card h2{margin-top:.6rem;font-family:var(--ff-d);font-size:clamp(1.7rem,3.2vw,2.5rem);font-weight:400;line-height:1.08;letter-spacing:-.02em}
.apply-card>div>p:last-child{max-width:52ch;margin-top:.8rem;font-size:.9rem;font-weight:300;line-height:1.7;color:var(--soft)}
.apply-contact{padding:1.1rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.apply-contact span{display:block;margin-bottom:.35rem;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.apply-contact a{font-family:var(--ff-d);font-size:clamp(1.3rem,2.4vw,1.8rem);color:var(--rust);overflow-wrap:anywhere}

/* ── footer ── */
.c-foot{padding:1.6rem 0;border-top:1px solid var(--line)}
.c-foot-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem;font-family:var(--ff-m);font-size:.56rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.c-foot-in>div:first-child{display:grid;gap:.25rem}
.c-foot strong{color:var(--ink)}
.c-foot-links{display:flex;gap:1.2rem}
.c-foot-links a:hover{color:var(--rust)}
.c-foot-in>span{justify-self:end}

@media(max-width:900px){
  .c-nav-in{grid-template-columns:1fr auto}
  .c-links{display:none}
  .c-hero-grid{grid-template-columns:1fr}
  .bgrid{grid-template-columns:1fr 1fr}
  .rswitch{grid-template-columns:1fr}
  .rpanel{min-height:0;position:static}
  .rview{position:static;inset:auto;display:none}
  .rview.on{display:flex}
  .apply-card{grid-template-columns:1fr;gap:1.8rem}
  .c-foot-in{grid-template-columns:1fr 1fr}
  .c-foot-links{display:none}
}
@media(max-width:640px){
  .cc{width:min(100% - 2rem,1140px)}
  .c-hero{padding:2.4rem 0 1.8rem}
  .c-hero h1{font-size:clamp(2.4rem,10vw,3.2rem)}
  .career-visual-copy{padding:1.25rem}
  .career-visual-copy h2{font-size:clamp(1.75rem,8vw,2.45rem)}
  .career-visual-copy p:last-child{display:none}
  .c-acts{display:grid}
  .hire{gap:.8rem}
  .hire-roles{margin-left:0;width:100%}
  .hire-chip{flex:1;justify-content:center}
  .bgrid{grid-template-columns:1fr}
  .rcols{grid-template-columns:1fr;gap:1rem}
  .c-foot-in{grid-template-columns:1fr;text-align:center}
  .c-foot-in>div:first-child{justify-items:center}
  .c-foot-in>span{justify-self:center}
}
@media(prefers-reduced-motion:reduce){.careers-page *{animation:none!important;transition:none!important}}
</style>
<div class="careers-page">

  <nav class="c-nav" aria-label="Main navigation">
    <div class="cc c-nav-in">
      <a class="c-brand" href="/">Nyx Solution</a>
      <div class="c-links">
        <a href="/#what-we-do">Agentic AI</a>
        <a href="/products">Products</a>
        <a href="/about">About</a>
        <a class="active" href="/careers">Careers</a>
      </div>
      <a class="c-nav-cta" href="/contact">Contact</a>
