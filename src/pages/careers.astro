<script is:inline>
const $=s=>document.querySelector(s), sleep=ms=>new Promise(r=>setTimeout(r,ms));
const REDUCED=matchMedia('(prefers-reduced-motion: reduce)').matches;

/* reveals */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('in');io.unobserve(e.target)}),{threshold:.14,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.rv:not(.in),.bcard').forEach(el=>io.observe(el));

/* ══ role switcher ══ */
[0,1].forEach(i=>{
  const tab=$('#tab'+i);
  const go=()=>{
    [0,1].forEach(k=>{
      $('#tab'+k).classList.toggle('on',k===i);
      $('#tab'+k).setAttribute('aria-selected',k===i);
      const v=$('#view'+k); v.classList.remove('on');
      if(k===i){ void v.offsetWidth; v.classList.add('on'); }
    });
  };
  tab.addEventListener('click',go);
  tab.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}});
});

/* ══ HERO · a pull request goes from opened to shipped ══ */
(async function pr(){
  const btn=$('#prBtn'), cur=$('#cur'), host=$('#pr');
  if(!btn||!cur||!host)return;
  const CHECKS=[['#pc0','42s'],['#pc1','142 passed'],['#pc2','Tally 6.6 · SAP S/4']];
  const reset=()=>{
    ['#pf0','#pf1','#pf2','#pf3'].forEach(f=>$(f).classList.remove('show'));
    CHECKS.forEach(([c])=>{$(c).className='pr-check';$(c).querySelector('em').textContent='—'});
    $('#pc3').className='pr-check'; $('#pc3').querySelector('em').textContent='—';
    $('#prNote').className='pr-note';
    $('#prNoteT').textContent='commented';
    $('#prNoteP').innerHTML='Logic looks right. Can the queue also show <em>why</em> it was held, not just that it was? A reviewer should not have to open the record.';
    $('#prState').className='pr-state'; $('#prState').textContent='Review required';
    $('#prMsg').className='pr-msg'; $('#prMsg').textContent='Waiting on review';
    btn.className='pr-merge'; btn.textContent='Merge';
  };
  if(REDUCED){ ['#pf0','#pf1','#pf2','#pf3'].forEach(f=>$(f).classList.add('show')); $('#prNote').classList.add('show'); return; }

  while(true){
    reset(); await sleep(800);
    for(const f of ['#pf0','#pf1','#pf2','#pf3']){ $(f).classList.add('show'); await sleep(150); }
    await sleep(400);

    for(const [c,label] of CHECKS){
      $(c).classList.add('show','run');
      $(c).querySelector('em').textContent='running';
      await sleep(760);
      $(c).className='pr-check show pass';
      $(c).querySelector('em').textContent=label;
      await sleep(140);
    }
    $('#pc3').classList.add('show','wait');
    $('#pc3').querySelector('em').textContent='required';
    await sleep(700);

    $('#prNote').classList.add('show');
    $('#prMsg').textContent='One comment · changes requested';
    await sleep(3400);

    $('#prNoteT').textContent='approved · 2 commits later';
    $('#prNoteP').innerHTML='Reason chip added to the row. Ship it.';
    $('#prNote').classList.add('approved');
    $('#pc3').className='pr-check show pass';
    $('#pc3').querySelector('em').textContent='Shubham';
    $('#prState').textContent='Approved';
    $('#prMsg').className='pr-msg ok'; $('#prMsg').textContent='All checks passed';
    btn.classList.add('live');
    await sleep(1000);

    const hr=host.getBoundingClientRect(), br=btn.getBoundingClientRect();
    const start='translate(230px, 300px)';
    const pos=`translate(${br.left-hr.left+br.width*.5}px, ${br.top-hr.top+br.height*.55}px)`;
    cur.style.setProperty('--pos',start); cur.style.transform=start; cur.classList.add('on');
    await sleep(120);
    cur.style.setProperty('--pos',pos); cur.style.transform=pos;
    await sleep(880);
    btn.classList.add('hot'); await sleep(360);
    cur.classList.add('tap');
    const rp=document.createElement('span'); rp.className='rip';
    rp.style.cssText='left:50%;top:50%;width:10px;height:10px';
    btn.appendChild(rp); requestAnimationFrame(()=>rp.classList.add('go'));
    await sleep(180);
    cur.classList.remove('tap','on'); btn.classList.remove('hot');
    btn.className='pr-merge done'; btn.textContent='Merged';
    $('#prState').className='pr-state merged'; $('#prState').textContent='Merged';
    $('#prMsg').textContent='Deployed to production · 12:06';
    await sleep(3400);
    rp.remove();
  }
})();
</script>
