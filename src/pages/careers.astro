---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Careers at Nyx Solution — Build Agentic AI Systems"
  description="Join Nyx Solution to build production agentic AI systems for ERP, TallyPrime, SAP, and complex business operations. Now hiring frontend and backend developers with 2–3 years of experience."
>
<style is:global>
.careers-page{
  --ink:#17161f;--soft:#4b4a5a;--muted:#7c7b8c;
  --rust:#4a3ad1;--rust-dk:#35279c;--rust-lt:#6a5af0;
  --ivory:#ffffff;--cream:#ffffff;--line:rgba(208,208,222,.42);
  --green:#1f7a45;--amber:#b26a00;--blue:#0f6b7a;
  --fe:#0f6b7a;--be:#4a3ad1;
  --ff-d:'Instrument Serif',Georgia,serif;--ff-b:'Sora',sans-serif;--ff-m:'DM Mono',monospace;
  min-height:100vh;color:var(--ink);font-family:var(--ff-b);line-height:1.65;
  background:var(--ivory);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{margin:0}
.careers-page a{text-decoration:none;color:inherit}
.careers-page ul{list-style:none}
.cc{width:min(1140px,calc(100vw - 3rem));margin:0 auto}

@keyframes cUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes cRise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes cPing{0%{box-shadow:0 0 0 0 rgba(74,58,209,.5)}70%{box-shadow:0 0 0 9px rgba(74,58,209,0)}100%{box-shadow:0 0 0 0 rgba(74,58,209,0)}}
@keyframes cSpin{to{transform:rotate(360deg)}}
.rv{opacity:0}.rv.in{animation:cUp .7s cubic-bezier(.22,.85,.44,1) both}

/* ── nav · matches the Home screen ── */
body:has(.careers-page) .nyx-site-nav{
  background:#fff;
  border-bottom-color:rgba(208,208,222,.62);
  box-shadow:0 1px 0 rgba(35,21,81,.025);
}
.c-nav{position:absolute;top:0;left:0;right:0;z-index:800;background:transparent;border-bottom:1px solid rgba(208,208,222,.5)}
.c-nav-in{display:flex;align-items:center;justify-content:space-between;padding:1.15rem 0;gap:1.5rem}
.careers-page .c-brand{font-family:var(--ff-d);font-size:1.42rem;line-height:1;color:var(--ink);text-shadow:0 1px 14px rgba(255,255,255,.9)}
.c-links{display:flex;align-items:center;gap:2rem}
.careers-page .c-links a{font-family:var(--ff-m);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--soft);text-shadow:0 1px 12px rgba(255,255,255,.9);transition:color .2s}
.careers-page .c-links a:hover,.careers-page .c-links a.active{color:var(--rust)}

/* ── hero ── */
.c-hero{padding:0}
.c-hero-grid{width:100%}
.c-ey,.c-kick{font-family:var(--ff-m);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:var(--rust)}
.c-ey{display:flex;align-items:center;gap:.65rem;margin-bottom:1.1rem}
.c-ey i{width:26px;height:1px;background:var(--rust)}
.c-hero h1{max-width:13ch;font-family:var(--ff-d);font-size:clamp(2.6rem,5.4vw,4.4rem);font-weight:400;line-height:1;letter-spacing:-.03em}
.c-hero h1 em{font-style:italic;color:var(--rust)}
.c-lead{max-width:52ch;margin-top:1.15rem;font-size:.95rem;font-weight:300;line-height:1.78;color:var(--soft)}
.c-acts{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}
.c-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 1.15rem;border:1px solid var(--ink);border-radius:4px;font-size:.76rem;font-weight:600;transition:transform .2s,background .2s,color .2s}
.c-btn:hover{transform:translateY(-2px)}
.careers-page .c-btn-p{color:#fff;background:var(--rust);border-color:var(--rust)}
.c-btn-p:hover{background:var(--rust-dk)}
.c-btn-s:hover{color:var(--rust);border-color:var(--rust)}

/* Recruitment hero with a dedicated text-safe area on the left */
.career-visual{position:relative;isolation:isolate;width:100%;height:min(900px,100svh);min-height:700px;overflow:hidden;background:#ffffff}
.career-visual>img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:none;transform:none}
.career-visual::after{display:none}
.career-visual-copy{position:relative;z-index:2;width:min(1140px,calc(100% - 3rem));height:100%;margin:0 auto;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:6.5rem min(52%,36rem) 8rem 0;text-align:left;color:var(--ink);text-shadow:none}
.career-visual-kicker{display:flex;align-items:center;gap:.7rem;margin-bottom:1rem;font-family:var(--ff-m);font-size:.64rem;letter-spacing:.15em;text-transform:uppercase;color:var(--rust)}
.career-visual-kicker::before{content:'';width:28px;height:1px;background:var(--rust-lt)}
.career-visual-kicker::after{display:none}
.career-visual-copy h1{max-width:11ch;font-family:var(--ff-d);font-size:clamp(3rem,4.8vw,4.8rem);font-weight:400;line-height:.96;letter-spacing:-.035em;color:var(--ink)}
.career-visual-copy h1 em{font-style:italic;color:var(--rust)}
.career-visual-lead{max-width:46ch;margin-top:1.15rem;font-size:.95rem;font-weight:300;line-height:1.7;color:var(--soft);text-shadow:none}
.career-visual .c-acts{justify-content:flex-start;margin-top:1.5rem}
.careers-page .career-visual .c-btn-p{color:#fff;background:var(--rust);border-color:var(--rust)}
.careers-page .career-visual .c-btn-p:hover{color:#fff;background:var(--rust-dk);border-color:var(--rust-dk)}
.careers-page .career-visual .c-btn-s{color:var(--ink);background:rgba(255,255,255,.88);border-color:var(--line);backdrop-filter:none}
.careers-page .career-visual .c-btn-s:hover{color:var(--rust);background:#fff;border-color:var(--rust-lt)}
.career-hiring-wrap{position:absolute;left:50%;bottom:2rem;z-index:3;transform:translateX(-50%)}
.career-visual .hire{width:max-content;max-width:100%;margin:0;padding:.7rem 1rem;gap:.85rem;border-radius:999px;color:var(--ink);background:rgba(255,255,255,.92);border-color:var(--line);box-shadow:0 16px 38px rgba(35,21,81,.12);backdrop-filter:none}
.career-visual .hire-live{color:var(--rust)}
.career-visual .hire-live i{background:var(--rust-lt)}
.career-visual .hire-n{font-size:1.7rem}
.career-visual .hire-n em{color:var(--soft)}
.career-visual .hire-n em{color:rgba(244,242,255,.75)}

/* ══ HERO ILLUSTRATION — a pull request ══
   The artifact every engineer reads without explanation:
   what changed, what the checks said, who reviewed it,
   and whether it shipped. */
.pr{border:1.5px solid rgba(208,208,222,.45);border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 24px 60px rgba(35,21,81,.13);position:relative}
.pr-bar{display:flex;align-items:center;gap:.45rem;padding:.48rem .75rem;background:linear-gradient(180deg,#f6f6fa,#eeeef5);border-bottom:1px solid var(--line);font-family:var(--ff-m);font-size:.6rem;color:var(--soft)}
.pr-bar b{color:var(--ink);font-weight:600}
.pr-bar .r{margin-left:auto;display:flex;align-items:center;gap:.35rem}
.pr-state{display:inline-flex;align-items:center;gap:.3rem;padding:.12rem .45rem;border-radius:999px;font-size:.52rem;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(178,106,0,.35);background:rgba(178,106,0,.1);color:var(--amber);transition:all .4s}
.pr-state.merged{border-color:rgba(74,58,209,.3);background:rgba(74,58,209,.1);color:var(--rust)}
.pr-body{padding:.7rem .8rem;display:flex;flex-direction:column;gap:.6rem}
.pr-title{font-size:.92rem;font-weight:600;line-height:1.35}
.pr-branch{display:flex;align-items:center;gap:.4rem;margin-top:.25rem;font-family:var(--ff-m);font-size:.55rem;color:var(--muted);flex-wrap:wrap}
.pr-branch code{padding:.06rem .32rem;border-radius:4px;background:rgba(74,58,209,.07);color:var(--rust-dk)}
.pr-who{display:inline-flex;align-items:center;gap:.35rem;margin-left:auto}
.pr-av{width:16px;height:16px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(140deg,#6a5af0,#35279c);font-family:var(--ff-m);font-size:.42rem;font-weight:600;color:#f4f2ff}

.pr-sec{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.3rem}
.pr-file{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:.5rem;padding:.26rem .45rem;border-radius:6px;font-family:var(--ff-m);font-size:.58rem;color:var(--soft);opacity:0;transform:translateY(6px)}
.pr-file.show{animation:cRise .32s cubic-bezier(.22,.85,.44,1) forwards}
.pr-file:nth-child(odd){background:rgba(74,58,209,.028)}
.pr-file .add{color:var(--green);font-size:.52rem}
.pr-file .del{color:#b3261e;font-size:.52rem}

.pr-check{display:grid;grid-template-columns:15px 1fr auto;align-items:center;gap:.5rem;padding:.24rem .45rem;font-size:.66rem;color:var(--soft);opacity:0}
.pr-check.show{animation:cRise .3s ease forwards}
.pr-check .ic{width:13px;height:13px;border-radius:50%;border:1.5px solid var(--line);background:#fff;display:grid;place-items:center;font-size:.4rem;color:transparent;transition:all .3s}
.pr-check.run .ic{border-color:var(--rust-lt);border-right-color:transparent;animation:cSpin .7s linear infinite}
.pr-check.pass .ic{background:var(--green);border-color:var(--green);color:#fff}
.pr-check.wait .ic{background:rgba(178,106,0,.15);border-color:var(--amber);color:var(--amber)}
.pr-check em{font-style:normal;font-family:var(--ff-m);font-size:.52rem;color:var(--muted);transition:color .3s}
.pr-check.pass em{color:#1f7a45}
.pr-check.wait em{color:var(--amber)}

.pr-note{display:grid;grid-template-columns:20px 1fr;gap:.5rem;padding:.5rem .55rem;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.9);opacity:0;transform:translateY(7px);transition:opacity .4s,transform .45s cubic-bezier(.22,.85,.44,1),border-color .4s,background .4s}
.pr-note.show{opacity:1;transform:none}
.pr-note.approved{border-color:rgba(31,122,69,.35);background:rgba(31,122,69,.05)}
.pr-note .pr-av{width:20px;height:20px;font-size:.46rem;background:linear-gradient(140deg,#0f6b7a,#2e1c6b)}
.pr-note b{display:block;font-size:.65rem;font-weight:600}
.pr-note b s{text-decoration:none;font-family:var(--ff-m);font-size:.5rem;font-weight:400;color:var(--muted);margin-left:.4rem}
.pr-note p{margin-top:.15rem;font-size:.72rem;font-weight:300;line-height:1.5;color:var(--soft)}

.pr-foot{display:flex;align-items:center;gap:.6rem;padding:.55rem .8rem;border-top:1px solid var(--line);background:#ffffff}
.pr-msg{font-family:var(--ff-m);font-size:.55rem;color:var(--muted);transition:color .4s}
.pr-msg.ok{color:#1f7a45}
.pr-merge{position:relative;overflow:hidden;margin-left:auto;padding:.34rem .8rem;border-radius:6px;background:rgba(74,58,209,.25);color:#fff;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:background .35s,transform .2s cubic-bezier(.34,1.5,.64,1),box-shadow .2s}
.pr-merge.live{background:var(--rust)}
.pr-merge.hot{transform:translateY(-2px);box-shadow:0 6px 14px rgba(74,58,209,.3)}
.pr-merge.done{background:var(--green)}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.6);transform:translate(-50%,-50%) scale(0);pointer-events:none}
.rip.go{animation:crp .5s ease-out forwards}
@keyframes crp{to{transform:translate(-50%,-50%) scale(12);opacity:0}}
.cursor{position:absolute;width:15px;height:15px;z-index:20;opacity:0;pointer-events:none;filter:drop-shadow(0 3px 6px rgba(35,21,81,.4));transition:transform .85s cubic-bezier(.33,.9,.28,1),opacity .3s}
.cursor.on{opacity:1}
.cursor.tap{transform:var(--pos) scale(.85)!important;transition:transform .1s ease}

/* ── hiring strip (was a large aside) ── */
.hire{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.6rem;margin-top:2.2rem;padding:.85rem 1.1rem;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.75)}
.hire-live{display:inline-flex;align-items:center;gap:.45rem;font-family:var(--ff-m);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--rust)}
.hire-live i{width:7px;height:7px;border-radius:50%;background:var(--rust);animation:cPing 2.2s ease-in-out infinite}
.hire-n{font-family:var(--ff-d);font-size:2rem;line-height:1;letter-spacing:-.02em}
.hire-n em{font-style:normal;font-family:var(--ff-b);font-size:.78rem;font-weight:400;color:var(--soft);margin-left:.45rem}
.hire-roles{margin-left:auto;display:flex;gap:.5rem;flex-wrap:wrap}
.hire-chip{display:inline-flex;align-items:center;gap:.5rem;padding:.34rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--cream);font-size:.76rem;transition:border-color .2s,transform .2s}
.hire-chip:hover{border-color:var(--rust);transform:translateY(-1px)}
.hire-chip b{font-family:var(--ff-m);font-size:.55rem;letter-spacing:.04em;color:var(--rust);font-weight:500}

/* ── why · compact cards with drawn glyphs ── */
.why{padding:clamp(3.2rem,6vw,4.5rem) 0;border-top:1px solid var(--line)}
.head{max-width:640px}
.head h2{margin-top:.6rem;font-family:var(--ff-d);font-size:clamp(1.9rem,3.6vw,2.9rem);font-weight:400;line-height:1.08;letter-spacing:-.02em}
.head>p{max-width:58ch;margin-top:.85rem;font-size:.92rem;font-weight:300;line-height:1.75;color:var(--soft)}
.bgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:2.2rem;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.bcard{background:rgba(255,255,255,.55);padding:1.25rem 1.2rem;transition:background .25s}
.bcard:hover{background:var(--cream)}
.bcard-top{display:flex;align-items:center;justify-content:space-between;gap:.6rem}
.bnum{font-family:var(--ff-m);font-size:.58rem;letter-spacing:.1em;color:var(--rust);opacity:.6}
.glyph{width:46px;height:26px}
.glyph path,.glyph rect,.glyph circle,.glyph line{stroke-dasharray:var(--l,60);stroke-dashoffset:var(--l,60);transition:stroke-dashoffset .9s cubic-bezier(.22,1,.36,1) var(--d,0ms)}
.bcard.in .glyph path,.bcard.in .glyph rect,.bcard.in .glyph circle,.bcard.in .glyph line{stroke-dashoffset:0}
.bcard h3{margin-top:.85rem;font-family:var(--ff-d);font-size:1.28rem;font-weight:400;line-height:1.2}
.bcard p{margin-top:.4rem;font-size:.82rem;font-weight:300;line-height:1.68;color:var(--soft)}

/* ── roles · dark chapter with a clear reading surface ── */
.roles{padding:clamp(4rem,7vw,5.5rem) 0;color:#f6f6fa;background:#21164e}
.roles .head{max-width:720px}
.roles .c-kick{color:#b7adff}
.roles .head h2{max-width:17ch;color:#fff}
.roles .head>p{color:rgba(244,242,255,.74)}
.rswitch{display:grid;grid-template-columns:.7fr 1.3fr;gap:1rem;margin-top:2.4rem;align-items:start}
.rpick{display:flex;flex-direction:column;gap:.65rem}
.rtab{position:relative;text-align:left;padding:1.1rem 1.15rem;border:1px solid rgba(244,242,255,.18);border-radius:13px;background:rgba(255,255,255,.045);cursor:pointer;font-family:inherit;color:inherit;transition:background .25s,border-color .25s,transform .25s,box-shadow .25s}
.rtab:hover{background:rgba(255,255,255,.075);border-color:rgba(183,173,255,.48)}
.rtab.on{color:var(--ink);background:#f8f7ff;border-color:#f8f7ff;box-shadow:0 18px 42px rgba(9,4,32,.22);transform:translateX(4px)}
.rtab:focus-visible{outline:2px solid #c3baff;outline-offset:3px}
.rtab::before{content:'';position:absolute;left:0;top:14%;bottom:14%;width:3px;border-radius:0 3px 3px 0;background:#6a5af0;transform:scaleY(0);transition:transform .35s}
.rtab.on::before{transform:scaleY(1)}
.rtab-top{display:flex;align-items:center;justify-content:space-between;gap:.7rem;font-family:var(--ff-m);font-size:.57rem;letter-spacing:.11em;text-transform:uppercase;color:#b7adff}
.rtab-top s{text-decoration:none;color:rgba(244,242,255,.58)}
.rtab.on .rtab-top,.rtab.on .rtab-top s{color:#5b49d6}
.rtab h3{margin-top:.55rem;font-family:var(--ff-d);font-size:1.65rem;font-weight:400;line-height:1.08;color:#fff}
.rtab.on h3{color:var(--ink)}
.rtab p{max-width:43ch;margin-top:.4rem;font-size:.8rem;font-weight:300;line-height:1.6;color:rgba(244,242,255,.7)}
.rtab.on p{color:#5d5a6d}
.rtab .exp{display:inline-block;margin-top:.7rem;padding:.24rem .55rem;border:1px solid rgba(183,173,255,.45);border-radius:999px;font-family:var(--ff-m);font-size:.54rem;letter-spacing:.05em;text-transform:uppercase;color:#c3baff}
.rtab.on .exp{color:#4a3ad1;background:rgba(74,58,209,.06);border-color:rgba(74,58,209,.22)}

.rpanel{position:relative;min-height:370px;border:1px solid rgba(255,255,255,.85);border-radius:14px;background:#f8f7ff;padding:1.5rem 1.6rem;box-shadow:0 22px 55px rgba(9,4,32,.2)}
.rview{position:absolute;inset:1.5rem 1.6rem;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .35s,transform .45s cubic-bezier(.22,.85,.44,1);display:flex;flex-direction:column}
.rview.on{opacity:1;transform:none;pointer-events:auto}
.rview-h{display:flex;align-items:baseline;justify-content:space-between;gap:.8rem;padding-bottom:.85rem;border-bottom:1px solid rgba(74,58,209,.14)}
.rview-h b{font-family:var(--ff-d);font-size:1.55rem;font-weight:400;color:var(--ink)}
.rview-h span{font-family:var(--ff-m);font-size:.55rem;letter-spacing:.08em;color:#777386}
.rcols{display:grid;grid-template-columns:1fr 1fr;gap:1.65rem;padding-top:1rem;flex:1}
.rcols h4{margin-bottom:.65rem;font-family:var(--ff-m);font-size:.57rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#4a3ad1}
.rcols li{position:relative;padding-left:1rem;margin-bottom:.55rem;font-size:.79rem;line-height:1.62;color:#514e60;opacity:0}
.rview.on .rcols li{animation:cRise .38s cubic-bezier(.22,.85,.44,1) forwards}
.rview.on .rcols li:nth-child(2){animation-delay:.06s}
.rview.on .rcols li:nth-child(3){animation-delay:.12s}
.rview.on .rcols li:nth-child(4){animation-delay:.18s}
.rcols li::before{content:'';position:absolute;top:.62em;left:0;width:5px;height:5px;border-radius:50%;background:#6a5af0}
.careers-page .rapply{display:inline-flex;align-items:center;align-self:flex-start;gap:.55rem;margin-top:auto;padding-top:1rem;border-top:1px solid rgba(74,58,209,.12);font-size:.8rem;font-weight:650;color:#35279c}
.rapply s{text-decoration:none;color:#4a3ad1;transition:transform .2s}
.rapply:hover s{transform:translate(3px,-3px)}

/* ── apply ── */
.apply{padding:3.2rem 0}
.apply-card{display:grid;grid-template-columns:1.2fr .8fr;align-items:end;gap:2.5rem;padding:clamp(1.5rem,3.5vw,2.4rem);border:1px solid var(--line);border-radius:16px;background:var(--cream)}
.apply-card h2{margin-top:.6rem;font-family:var(--ff-d);font-size:clamp(1.7rem,3.2vw,2.5rem);font-weight:400;line-height:1.08;letter-spacing:-.02em}
.apply-card>div>p:last-child{max-width:52ch;margin-top:.8rem;font-size:.9rem;font-weight:300;line-height:1.7;color:var(--soft)}
.apply-contact{padding:1.1rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.apply-contact span{display:block;margin-bottom:.35rem;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.apply-contact a{font-family:var(--ff-d);font-size:clamp(1.3rem,2.4vw,1.8rem);color:var(--rust);overflow-wrap:anywhere}

/* ── footer ── */
.c-foot{padding:1.6rem 0;border-top:1px solid var(--line)}
.c-foot-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem;font-family:var(--ff-m);font-size:.56rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.c-foot-in>div:first-child{display:grid;gap:.25rem}
.c-foot strong{color:var(--ink)}
.c-foot-links{display:flex;gap:1.2rem}
.c-foot-links a:hover{color:var(--rust)}
.c-foot-in>span{justify-self:end}

@media(max-width:900px){
  .bgrid{grid-template-columns:1fr 1fr}
  .rswitch{grid-template-columns:1fr}
  .rpanel{min-height:0;position:static}
  .rview{position:static;inset:auto;display:none}
  .rview.on{display:flex}
  .apply-card{grid-template-columns:1fr;gap:1.8rem}
  .c-foot-in{grid-template-columns:1fr 1fr}
  .c-foot-links{display:none}
}
@media(max-width:640px){
  .cc{width:min(100% - 2rem,1140px)}
  .c-nav-in{flex-direction:column;align-items:flex-start;gap:.3rem;padding:.65rem 0}
