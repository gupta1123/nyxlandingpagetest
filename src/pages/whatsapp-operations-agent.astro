    <div class="caps-grid">
      <article class="cap"><span class="cap-n">01</span><h3>Verified customer access</h3><p>Restricts account-specific information and actions to approved customer identities and mapped WhatsApp numbers.</p><span class="cap-meta">number → account mapping</span></article>
      <article class="cap"><span class="cap-n">02</span><h3>SAP-grounded responses</h3><p>Reads current order, invoice, and receivable information before answering operational questions.</p><span class="cap-meta">read at answer time · no cache</span></article>
      <article class="cap"><span class="cap-n">03</span><h3>Human approval gates</h3><p>Routes price changes, exceptional terms, high-risk actions, or final order creation to an authorized employee when required.</p><span class="cap-meta">price · terms · order creation</span></article>
      <article class="cap"><span class="cap-n">04</span><h3>Duplicate-action prevention</h3><p>Uses transaction and conversation context to reduce repeated order creation, invoice delivery, or reminder actions.</p><span class="cap-meta">order · invoice · reminder</span></article>
      <article class="cap"><span class="cap-n">05</span><h3>Configurable follow-up rules</h3><p>Supports business-defined due-date checks, reminder intervals, customer groups, and escalation paths.</p><span class="cap-meta">intervals · groups · escalation</span></article>
      <article class="cap"><span class="cap-n">06</span><h3>Admin visibility and auditability</h3><p>Shows what the customer requested, what the agent checked, which approvals occurred, and what was finally sent or executed.</p><span class="cap-meta">asked · checked · approved · sent</span></article>
    </div>
  </div>
</section>

<!-- ══ BEST FIT ══ -->
<section class="wa-apply">
  <div class="container">
    <div class="wa-apply__grid">
      <div class="reveal-up">
        <span class="eyebrow">Best fit for</span>
        <h2 class="sh2">Businesses whose customers already live <em>in the chat window</em></h2>
        <p class="wa-apply__sub">The agent suits organisations taking repeat B2B orders and status requests through WhatsApp, while orders, invoices and receivables stay in SAP.</p>
      </div>
      <ul class="wa-apply__list">
        <li class="wa-apply__item"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Steel manufacturers and distributors</li>
        <li class="wa-apply__item" style="animation-delay:.08s"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>B2B companies receiving repeat orders</li>
        <li class="wa-apply__item" style="animation-delay:.16s"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Teams using SAP for orders and invoicing</li>
        <li class="wa-apply__item" style="animation-delay:.24s"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Finance teams managing payment follow-ups</li>
        <li class="wa-apply__item" style="animation-delay:.32s"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Customer-service teams handling status requests</li>
        <li class="wa-apply__item" style="animation-delay:.40s"><span class="wa-apply__check"><svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Businesses that need controlled WhatsApp automation</li>
      </ul>
    </div>
  </div>
</section>

<!-- ══ CTA ══ -->
<section class="wa-cta" id="cta">
  <div class="narrow">
    <div class="wa-cta__card" id="ctaCard">
      <div class="wa-cta__glow" aria-hidden="true"></div>
      <span class="eyebrow">Get in touch</span>
      <h2>Bring customers closer to the system of record</h2>
      <p class="wa-cta__sub">We configure the agent around your SAP access, approval matrix, product catalogue, customer verification rules, invoice workflow, and collection policy.</p>
      <div class="wa-note"><i></i><span>SAP sales-order creation is enabled only where the required simulation, creation, and approval access is available.</span></div>
      <div class="cta-row center" style="margin-top:1.8rem">
        <a class="btn primary" href="/contact">Discuss a WhatsApp Workflow</a>
        <a class="btn ghost" href="/products#whatsapp-agent">Back to Products</a>
      </div>
    </div>
  </div>
</section>

<footer><p>&copy; 2026 <strong>Nyx Solution</strong> · WhatsApp Business Operations Agent — SAP connected</p></footer>

<script is:inline>
const $=s=>document.querySelector(s), sleep=ms=>new Promise(r=>setTimeout(r,ms));
const REDUCED=matchMedia('(prefers-reduced-motion: reduce)').matches;
const TICK='<svg class="tick" viewBox="0 0 16 9"><path d="M1 5l2.6 2.6L8.4 2.4"/><path d="M6.4 5L9 7.6 14 2"/></svg>';
addEventListener('scroll',()=>$('#mainnav').classList.toggle('scrolled',scrollY>40),{passive:true});
(()=>{const w=['Verified customer access','SAP-grounded responses','Human approval gates','Duplicate-action prevention','Configurable follow-up rules','Admin visibility and auditability'];
$('#ticker').innerHTML=Array.from({length:3},()=>w.map(x=>`<span class="ticker-item">${x}</span>`).join('')).join('')})();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('in-view');io.unobserve(e.target)}),{threshold:.15,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.wa-apply__item,#problemCard,#ctaCard').forEach(el=>io.observe(el));
const when=(el,fn)=>{if(el)new IntersectionObserver((e,o)=>{if(e[0].isIntersecting){o.disconnect();fn()}},{threshold:.25}).observe(el)};

/* thread helpers */
const say=(host,kind,html,t='12:04')=>{const d=document.createElement('div');
  d.className='msg '+kind;
  d.innerHTML=html+`<span class="mt">${t}${kind==='out'?TICK:''}</span>`;
  host.appendChild(d); if(host.children.length>7) host.firstChild.remove(); return d};
const typing=async(host,pres,ms)=>{if(pres)pres.textContent='typing…';
  const d=document.createElement('div');d.className='typing';d.innerHTML='<i></i><i></i><i></i>';
  host.appendChild(d);await sleep(ms);d.remove();if(pres)pres.textContent='online'};

/* ══ HERO · the four controls, in step with the conversation ══ */
(async function hero(){
  const th=$('#hThread'), steps=['#hs0','#hs1','#hs2','#hs3'];
  const set=(i,cls)=>{$(steps[i]).className='step '+cls};
  if(REDUCED){say(th,'in','Rate 54,200 par 25 MT confirm karein?');steps.forEach((s,i)=>set(i,'done'));return}
  while(true){
    th.innerHTML=''; steps.forEach((s,i)=>set(i,''));
    $('#hFoot').textContent='A message is a request — never permission to act';
    await sleep(700);
    say(th,'in','Rajesh here — 25 MT Fe-500D 12mm chahiye, 29 Aug delivery');
    set(0,'on'); await sleep(1100); set(0,'done');
    await sleep(400);
    set(1,'on'); $('#hFoot').textContent='Reading order, pricing and credit state from SAP';
    await typing(th,$('#hPres'),1200);
    set(1,'done');
    say(th,'out','Noted. Your PL-02 rate is ₹54,200/MT. Credit terms 45 days.');
    await sleep(1000);
    say(th,'in','Rate 52,400 kar do, order abhi place karta hoon');
    await sleep(800);
    set(2,'hold'); $('#hFoot').textContent='Price below list — held for the sales head';
    say(th,'out','That rate is below list. I have sent it to the sales head — I will not confirm it myself.');
    await sleep(2400);
    set(2,'done'); $('#hs2d').textContent='approved · S. Deshpande 12:06';
    await sleep(600);
    set(3,'on'); await sleep(900); set(3,'done');
    say(th,'out','Approved ✅ 25 MT at ₹52,400/MT. Order 45001229 created, delivery 29 Aug.');
    $('#hFoot').textContent='Result returned to the customer and the admin team';
    await sleep(3600);
    $('#hs2d').textContent='price exception · sales head';
  }
})();

/* ══ 1 · GUIDED ORDER CAPTURE + COMMERCIAL EXCEPTION ══ */
when($('#p1'),async()=>{
  const th=$('#p1thread'), pres=$('#p1pres');
  const SEQ=[
    ['in','Fe-500D chahiye is hafte'],
    ['out','Sure. Which size — 8, 10, 12 or 16 mm?','#f0'],
    ['in','12 mm','#f1'],
    ['out','Quantity and delivery date?','#f2'],
    ['in','25 MT, 29 Aug Jalna works','#f3'],
    ['out','Got it. PL-02 rate for you is ₹54,200/MT.','#f4']
  ];
  await sleep(400);
  for(const [k,txt,fld] of SEQ){
    if(k==='out') await typing(th,pres,700);
    say(th,k,txt);
    if(fld) $(fld).classList.add('set');
    await sleep(760);
  }
  $('#f5').classList.add('set');
  await sleep(500);
  say(th,'in','52,400 kar sakte ho?');
  await sleep(700);
  $('#p1appr').classList.add('show');
  $('#p1foot').textContent='Commercial exception — the agent will not price it alone';
  await sleep(1000);
  const btn=$('#p1btn'), cur=$('#p1cur'), host=$('#p1').getBoundingClientRect(), br=btn.getBoundingClientRect();
  const start='translate(300px, 320px)', pos=`translate(${br.left-host.left+br.width*.5}px, ${br.top-host.top+br.height*.55}px)`;
  cur.style.setProperty('--pos',start); cur.style.transform=start; cur.classList.add('on');
  await sleep(130);
  cur.style.setProperty('--pos',pos); cur.style.transform=pos;
  await sleep(950);
  btn.classList.add('hot'); await sleep(400);
  cur.classList.add('tap'); btn.classList.add('press');
  const rp=document.createElement('span'); rp.className='rip'; rp.style.cssText='left:50%;top:50%;width:12px;height:12px';
  btn.appendChild(rp); requestAnimationFrame(()=>rp.classList.add('go'));
  await sleep(190);
  cur.classList.remove('tap','on'); btn.classList.remove('press','hot');
  btn.classList.add('ok'); btn.textContent='Approved ✓';
  $('#p1appr').classList.add('done');
  $('#p1apprH').textContent='Approved · S. Deshpande · sales head';
  await typing(th,pres,700);
  say(th,'out','Approved ✅ 25 MT at ₹52,400/MT — confirming your order now.');
  $('#p1foot').textContent='Draft DRAFT-8842 ready for order creation';
});

/* ══ 2 · SAP READ, VERIFIED ANSWER, CONFLICT ESCALATED ══ */
when($('#p2'),async()=>{
  const th=$('#p2thread');
  say(th,'in','Order ka kya status hai?');
  await sleep(500);
  for(const ln of [...document.querySelectorAll('#p2term .ln')]){ ln.classList.add('show'); await sleep(280); }
  await sleep(400);
  $('#p2conn').classList.remove('busy'); $('#p2conn').innerHTML='<i></i>SAP · read 12:04:06';
  const ROWS=[
    ['45001229','TMT Fe-500D 12mm','25.000','In transit','29 Aug','ok'],
    ['45001188','TMT Fe-500D 16mm','12.000','Delivered','21 Aug','ok'],
    ['45001204','MS billet','8.000','Conflicting records','—','ex']
  ];
  const tb=$('#p2rows');
  for(const [o,m,q,s,d,cls] of ROWS){
    const tr=document.createElement('tr'); tr.className='row '+cls;
    tr.innerHTML=`<td class="nm">${o}</td><td>${m}</td><td class="hide-s num">${q}</td>
      <td><span class="pill2 ${cls==='ex'?'warn':'ok'}">${s}</span></td><td class="hide-s">${d}</td>`;
    tb.appendChild(tr); requestAnimationFrame(()=>tr.classList.add('show'));
    await sleep(340);
  }
  await sleep(500);
  await typing(th,null,800);
  say(th,'out','Order 45001229 — 25 MT, in transit, delivery 29 Aug.');
  await sleep(900);
  say(th,'out','One more order (45001204) shows conflicting records. I have passed it to our team rather than guess.');
  $('#p2foot').textContent='Conflicting record escalated · not answered from cache';
});

/* ══ 3 · ELIGIBLE DOC → RECIPIENT CHECK → SEND → LOG ══ */
when($('#p3'),async()=>{
  const tb=$('#p3rows'), th=$('#p3thread'), log=$('#p3log');
  const DOCS=[
    ['9034412','Suryadev Alloys','₹4,80,000','sel'],
    ['9034488','German Steel','₹11,20,000',''],
    ['9034501','Metaroll','₹1,24,560','']
  ];
  for(const [d,a,v,cls] of DOCS){
    const tr=document.createElement('tr'); tr.className='row '+cls;
    tr.innerHTML=`<td class="nm">${d}</td><td>${a}</td><td class="num">${v}</td>`;
    tb.appendChild(tr); requestAnimationFrame(()=>tr.classList.add('show'));
    await sleep(280);
  }
  await sleep(500);
  for(const id of ['#r0','#r1','#r2']){ $(id).classList.add('set'); await sleep(420); }
  const addLog=(t,e,d)=>{const tr=document.createElement('tr');tr.className='row';
    tr.innerHTML=`<td>${t}</td><td class="nm">${e}</td><td class="hide-s">${d}</td>`;
    log.appendChild(tr);requestAnimationFrame(()=>tr.classList.add('show'))};
  addLog('12:04:07','Matched','doc 9034412 → account 100482');
  await sleep(500);
  const doc=document.createElement('div');
  doc.className='msg out';
  doc.innerHTML=`<div class="docmsg"><span class="ic">PDF</span><span style="min-width:0"><b>INV-9034412.pdf</b><span>214 kB · 2 pages</span></span></div><span class="mt">12:04${TICK}</span>`;
  th.appendChild(doc);
  $('#p3state').textContent='sent';
  addLog('12:04:08','Sent','to verified number ····231');
  await sleep(700);
  say(th,'out','Invoice <b>INV-9034412</b> · ₹4,80,000 · due <b>12 Sep 2026</b>');
  await sleep(600);
  $('#p3state').textContent='delivered';
  addLog('12:04:09','Delivered','handset acknowledged');
  await sleep(800);
  [...th.querySelectorAll('.msg.out')].forEach(m=>m.classList.add('read'));
  $('#p3state').textContent='read';
  addLog('12:06:22','Read','customer opened the document');
  $('#p3foot').textContent='Every delivery event is on record for the admin team';
});

/* ══ 4 · POLICY SCHEDULE, RE-CHECK, STOP WHEN CLEARED ══ */
when($('#p4'),async()=>{
  const tb=$('#p4rows'), th=$('#p4thread');
  const add=(s,b,a,cls='')=>{const tr=document.createElement('tr');tr.className='row '+cls;
    tr.innerHTML=`<td class="nm">${s}</td><td>${b}</td><td>${a}</td>`;
    tb.appendChild(tr);requestAnimationFrame(()=>tr.classList.add('show'));return tr};
  await sleep(400);
  add('Due + 3d','₹4,80,000 open','Reminder sent');
  $('#mSent').textContent='1';
  await typing(th,$('#p4pres'),700);
  say(th,'out','Gentle reminder — invoice INV-9034412 for ₹4,80,000 was due 12 Sep.','15 Sep');
  await sleep(1100);
  add('Due + 7d','₹4,80,000 open','Reminder sent');
  $('#mSent').textContent='2';
  await typing(th,$('#p4pres'),650);
  say(th,'out','Following up on INV-9034412 — still showing open at our end.','19 Sep');
  await sleep(1200);
  say(th,'in','Payment ho gaya hai, UTR 4471','20 Sep');
  await sleep(700);
  $('#p4conn').classList.add('busy'); $('#p4conn').innerHTML='<i></i>Re-checking';
  await sleep(1100);
  $('#p4conn').classList.remove('busy'); $('#p4conn').innerHTML='<i></i>Receivables';
  $('#p4bal').textContent='balance cleared';
  const tr=add('Due + 15d','₹0 · cleared in SAP','Cancelled','ok');
  $('#mSent').textContent='2'; $('#mPend').textContent='0'; $('#mRes').textContent='1';
  await typing(th,$('#p4pres'),650);
  say(th,'out','Received — SAP shows it cleared on 20 Sep. No further reminders will go out.','20 Sep');
  $('#p4foot').textContent='Escalation at +30d cancelled · follow-up resolved';
});
</script>
</MainLayout>
