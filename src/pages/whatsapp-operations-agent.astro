---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="WhatsApp Business Operations Agent | Nyx Solution"
  description="A WhatsApp operations agent for verified ordering, SAP-connected status updates, invoice delivery, approvals, and automated payment follow-ups."
>
<style is:global>
:root{
  --rust-50:#fdf8ef;--rust-100:#f5ebda;--rust-200:#e9c9a8;
  --rust-300:#da956a;--rust-400:#c56f45;--rust-500:#a24a2a;
  --rust-600:#85361c;--rust-700:#6b2a14;
  --sand-50:#fff8ed;--sand-100:#f5e8d4;--sand-200:#d8c8b3;
  --ink:#1f1a16;--ink-soft:#5f5148;--ink-muted:#7a5c4c;
  --surface:#fdf8ef;--line:rgba(216,200,179,.78);--line-mid:rgba(196,160,126,.45);
  --green:#2e8c4f;--amber:#c07820;--blue:#3c5a8c;--dark-bg:#2e1f19;
  --wa-out:#0b4f3f;--wa-in:#1e2b30;--wa-bg:#0b1418;
  --ff-d:'Instrument Serif',Georgia,serif;--ff-b:'Sora',sans-serif;--ff-m:'DM Mono',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:radial-gradient(circle at 92% 4%,rgba(162,74,42,.13) 0,rgba(162,74,42,0) 40%),radial-gradient(circle at 6% 18%,rgba(255,226,171,.26) 0,rgba(255,226,171,0) 38%),var(--surface);color:var(--ink);font-family:var(--ff-b);font-size:16px;line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}

@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes fadeScale{from{opacity:0;transform:scale(.93)}to{opacity:1;transform:scale(1)}}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:translateY(9px) scale(.97)}to{opacity:1;transform:none}}
@keyframes listIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(162,74,42,.55)}70%{box-shadow:0 0 0 10px rgba(162,74,42,0)}100%{box-shadow:0 0 0 0 rgba(162,74,42,0)}}
@keyframes blip{0%,100%{box-shadow:0 0 0 0 rgba(46,140,79,.45)}50%{box-shadow:0 0 0 5px rgba(46,140,79,0)}}
@keyframes hold{0%,100%{box-shadow:0 0 0 0 rgba(192,120,32,.45)}60%{box-shadow:0 0 0 7px rgba(192,120,32,0)}}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes glowPulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:.8;transform:scale(1.07)}}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes dots{0%,60%,100%{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
@keyframes spin{to{transform:rotate(360deg)}}
.reveal-up{animation:fadeUp .75s cubic-bezier(.22,.85,.44,1) both}
.reveal-fade{animation:fadeScale .7s cubic-bezier(.22,.85,.44,1) both}

/* ── NAV / TICKER / LAYOUT ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:.9rem 2.8rem;background:rgba(253,248,239,.93);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);transition:padding .3s}
nav.scrolled{padding-top:.6rem;padding-bottom:.6rem}
.nav-left{display:flex;align-items:center;gap:.7rem}
.nav-back{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:rgba(255,252,244,.7);color:var(--rust-600);display:inline-flex;align-items:center;justify-content:center;transition:all .2s}
.nav-back:hover{background:var(--rust-50);border-color:var(--rust-300);transform:translateY(-1px)}
.nav-logo{font-family:var(--ff-d);font-size:1.3rem;font-style:italic;color:var(--rust-600)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{font-size:.83rem;color:var(--ink-soft);transition:color .2s}
.nav-links a:hover{color:var(--rust-500)}
.nav-cta{font-size:.83rem;font-weight:600;padding:.46rem 1.15rem;border-radius:8px;background:var(--rust-500);color:#fff;transition:all .2s}
.nav-cta:hover{background:var(--rust-600);transform:translateY(-1px)}
.ticker-wrap{margin-top:63px;overflow:hidden;background:linear-gradient(90deg,#f3e6cf,#ecd8b8);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:.5rem 0}
.ticker{display:flex;width:max-content;white-space:nowrap;animation:ticker 32s linear infinite}
.ticker-item{font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-600);padding:0 2.2rem;flex-shrink:0}
.ticker-item::after{content:'·';margin-left:2.2rem;color:var(--rust-400)}
.container{max-width:1160px;margin:0 auto;padding:0 2.4rem}
.narrow{max-width:820px;margin:0 auto;padding:0 2.4rem}
.eyebrow{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--rust-500);display:block;margin-bottom:.55rem}
.sh2{font-family:var(--ff-d);font-size:clamp(1.8rem,3.2vw,2.6rem);font-weight:400;line-height:1.18;letter-spacing:-.01em;color:var(--ink)}
.sh2 em{font-style:italic;color:var(--rust-500)}
.btn{display:inline-block;font-size:.88rem;font-weight:600;border-radius:8px;padding:.66rem 1.5rem;transition:all .2s}
.btn.primary{background:var(--rust-500);color:#fff;box-shadow:0 4px 18px rgba(162,74,42,.28)}
.btn.primary:hover{background:var(--rust-600);transform:translateY(-2px)}
.btn.ghost{border:1.5px solid var(--line-mid);color:var(--rust-600)}
.btn.ghost:hover{background:var(--rust-50);transform:translateY(-2px)}
.cta-row{display:flex;gap:.85rem;flex-wrap:wrap}
.cta-row.center{justify-content:center}

/* ══ APP CHROME — every illustration is a real screen ══ */
.app{border:1.5px solid var(--line-mid);border-radius:14px;background:#fffdf8;overflow:hidden;box-shadow:0 26px 66px rgba(75,42,21,.14),0 3px 12px rgba(75,42,21,.06);display:flex;flex-direction:column}
.app-bar{display:flex;align-items:center;gap:.5rem;padding:.55rem .8rem;background:linear-gradient(180deg,#f7ecd8,#f2e4cd);border-bottom:1px solid var(--line)}
.app-dots{display:flex;gap:4.5px;margin-right:.2rem}
.app-dots i{width:9px;height:9px;border-radius:50%}
.app-dots i:nth-child(1){background:#f06257}.app-dots i:nth-child(2){background:#f5a623}.app-dots i:nth-child(3){background:#57c257}
.app-name{font-family:var(--ff-m);font-size:.66rem;font-weight:600;color:var(--ink)}
.app-name span{color:var(--ink-muted);font-weight:400}
.app-conn{margin-left:auto;display:flex;align-items:center;gap:.3rem;font-family:var(--ff-m);font-size:.55rem;letter-spacing:.07em;text-transform:uppercase;color:var(--green)}
.app-conn i{width:5px;height:5px;border-radius:50%;background:var(--green);animation:blip 2s ease-in-out infinite}
.app-conn.busy{color:var(--amber)}.app-conn.busy i{background:var(--amber);animation:hold 1.2s ease infinite}
.app-tool{display:flex;align-items:center;gap:.45rem;padding:.4rem .7rem;border-bottom:1px solid var(--line);background:#fffdf8;font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted)}
.app-tool .r{margin-left:auto;display:flex;align-items:center;gap:.5rem}
.app-file{display:flex;align-items:center;gap:.32rem;padding:.14rem .42rem;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink)}
.app-file svg{color:var(--rust-500);flex-shrink:0}
.app-body{padding:.6rem .7rem;display:flex;flex-direction:column;gap:.5rem;flex:1;min-height:0}
.app-foot{display:flex;align-items:center;gap:.5rem;padding:.4rem .75rem;border-top:1px solid var(--line);background:#fffaf0;font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted)}
.app-foot .r{margin-left:auto}
.duo{display:grid;grid-template-columns:1fr 1.06fr;gap:.6rem;flex:1;min-height:0}
.sub-h{font-family:var(--ff-m);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:.3rem;display:flex;justify-content:space-between;align-items:baseline}
.sub-h em{font-style:normal;font-size:.46rem;color:var(--green)}

/* ── the customer's side: a real thread ── */
.th{border-radius:10px;background:var(--wa-bg);background-image:radial-gradient(rgba(255,225,190,.035) 1px,transparent 1px);background-size:15px 15px;border:1px solid rgba(255,215,170,.14);overflow:hidden;display:flex;flex-direction:column;min-height:0}
.th-h{display:flex;align-items:center;gap:.45rem;padding:.4rem .55rem;background:#0f2a24;border-bottom:1px solid rgba(255,255,255,.05)}
.th-av{width:22px;height:22px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;background:linear-gradient(140deg,#c05f34,#7d3a1c);font-family:var(--ff-m);font-size:.46rem;font-weight:600;color:#ffeede}
.th-who{flex:1;min-width:0}
.th-who b{display:block;font-size:.6rem;font-weight:500;color:#eef4f2;line-height:1.2}
.th-who span{font-size:.46rem;color:#7fa89c}
.th-scroll{flex:1;overflow:hidden;position:relative;padding:.45rem .5rem}
.th-in{position:absolute;left:0;right:0;bottom:0;padding:0 .5rem .45rem}
.msg{max-width:86%;margin-bottom:.28rem;padding:.3rem .42rem .26rem;border-radius:7px;font-size:.6rem;line-height:1.45;color:#e7eeec;word-wrap:break-word;box-shadow:0 1px 1px rgba(0,0,0,.28);animation:pop .3s cubic-bezier(.22,1.2,.4,1) both}
.msg.in{background:var(--wa-in);border-top-left-radius:2px;margin-right:auto}
.msg.out{background:var(--wa-out);border-top-right-radius:2px;margin-left:auto}
.msg .mt{display:flex;align-items:center;justify-content:flex-end;gap:3px;margin-top:1px;font-size:.44rem;color:rgba(230,240,236,.45)}
.tick{width:12px;height:7px;flex-shrink:0}
.tick path{stroke:rgba(230,240,236,.5);stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round;transition:stroke .45s}
.msg.read .tick path{stroke:#53bdeb}
.typing{display:inline-flex;gap:3px;padding:.4rem .48rem;border-radius:7px;background:var(--wa-in);border-top-left-radius:2px;margin-bottom:.28rem}
.typing i{width:4.5px;height:4.5px;border-radius:50%;background:rgba(230,240,236,.45);animation:dots 1.3s infinite}
.typing i:nth-child(2){animation-delay:.18s}.typing i:nth-child(3){animation-delay:.36s}
.docmsg{display:flex;align-items:center;gap:.38rem;padding:.34rem .38rem;border-radius:6px;background:rgba(255,255,255,.06);margin-bottom:.26rem}
.docmsg .ic{width:22px;height:26px;border-radius:3px;flex-shrink:0;background:#f5f1ea;display:grid;place-items:center;font-family:var(--ff-m);font-size:.36rem;font-weight:600;color:#b2352a;position:relative}
.docmsg b{display:block;font-size:.55rem;font-weight:500;color:#eef4f2;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.docmsg span{font-size:.44rem;color:rgba(230,240,236,.45)}

/* ── the business side: a control rail ── */
.rail{display:flex;flex-direction:column;gap:.26rem}
.step{display:grid;grid-template-columns:17px 1fr;gap:.45rem;align-items:start;padding:.36rem .45rem;border-radius:7px;border:1px solid transparent;transition:background .35s,border-color .35s}
.step .dot{width:15px;height:15px;border-radius:50%;border:1.5px solid var(--line-mid);background:#fff;display:grid;place-items:center;font-family:var(--ff-m);font-size:.42rem;color:var(--ink-muted);margin-top:1px;transition:all .35s}
.step b{display:block;font-size:.63rem;font-weight:500;color:var(--ink-muted);line-height:1.3;transition:color .35s}
.step span{display:block;font-family:var(--ff-m);font-size:.5rem;color:var(--ink-muted);opacity:0;max-height:0;overflow:hidden;transition:opacity .4s,max-height .4s,color .35s}
.step.on{background:rgba(162,74,42,.05);border-color:rgba(162,74,42,.18)}
.step.on b{color:var(--ink)}
.step.on span{opacity:1;max-height:32px}
.step.on .dot{border-color:var(--rust-400);border-right-color:transparent;animation:spin .8s linear infinite}
.step.done{background:rgba(46,140,79,.05);border-color:rgba(46,140,79,.2)}
.step.done b{color:var(--ink)}
.step.done span{opacity:1;max-height:32px;color:#3a7a4c}
.step.done .dot{background:var(--green);border-color:var(--green);color:#fff}
.step.hold{background:rgba(192,120,32,.07);border-color:rgba(192,120,32,.32)}
.step.hold b{color:var(--ink)}
.step.hold span{opacity:1;max-height:32px;color:var(--amber)}
.step.hold .dot{background:var(--amber);border-color:var(--amber);color:#fff;animation:hold 1.3s ease infinite}

/* approval card */
.appr{margin-top:.3rem;border:1px solid rgba(192,120,32,.4);border-radius:8px;background:#fffaf0;padding:.45rem .5rem;opacity:0;transform:translateY(6px);transition:all .45s}
.appr.show{opacity:1;transform:none}
.appr.done{border-color:rgba(46,140,79,.4);background:rgba(46,140,79,.06)}
.appr-h{font-family:var(--ff-m);font-size:.48rem;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);margin-bottom:.24rem;transition:color .4s}
.appr.done .appr-h{color:#1c6535}
.appr p{font-size:.6rem;line-height:1.5;color:var(--ink-soft)}
.appr p b{color:var(--ink);font-weight:500}
.appr-acts{display:flex;gap:.3rem;margin-top:.4rem}
.abtn{padding:.26rem .5rem;border-radius:6px;font-family:var(--ff-m);font-size:.48rem;letter-spacing:.07em;text-transform:uppercase;border:1px solid var(--line);color:var(--ink-muted);background:#fff}
.abtn.pri{flex:1;position:relative;overflow:hidden;text-align:center;background:var(--amber);color:#fff;border-color:transparent;transition:transform .2s cubic-bezier(.34,1.5,.64,1),box-shadow .2s,background .3s}
.abtn.pri.hot{transform:translateY(-2px);box-shadow:0 6px 14px rgba(192,120,32,.3)}
.abtn.pri.press{transform:translateY(1px) scale(.97)}
.abtn.pri.ok{background:var(--green)}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.6);transform:translate(-50%,-50%) scale(0);pointer-events:none}
.rip.go{animation:rp .55s ease-out forwards}
@keyframes rp{to{transform:translate(-50%,-50%) scale(14);opacity:0}}
.cursor{position:absolute;width:17px;height:17px;z-index:40;opacity:0;pointer-events:none;filter:drop-shadow(0 4px 8px rgba(60,38,18,.4));transition:transform .95s cubic-bezier(.33,.9,.28,1),opacity .3s}
.cursor.on{opacity:1}
.cursor.tap{transform:var(--pos) scale(.85)!important;transition:transform .11s ease}

/* data tables + fields */
.tbl{width:100%;border-collapse:collapse;font-family:var(--ff-m)}
.tbl th{text-align:left;font-size:.48rem;font-weight:500;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-muted);padding:.26rem .38rem;border-bottom:1px solid var(--line);background:rgba(162,74,42,.03);white-space:nowrap}
.tbl td{font-size:.57rem;color:var(--ink-soft);padding:.3rem .38rem;border-bottom:1px solid rgba(216,200,179,.5)}
.tbl tr:last-child td{border-bottom:none}
.tbl .num{text-align:right;white-space:nowrap;color:var(--ink)}
.tbl .nm{color:var(--ink);font-weight:500}
.tbl tr.row{opacity:0}
.tbl tr.row.show{animation:rise .32s cubic-bezier(.22,.85,.44,1) forwards}
.tbl tr.ok td{background:rgba(46,140,79,.05)}
.tbl tr.ex td{background:rgba(192,120,32,.08)}
.tbl tr.sel td{background:rgba(162,74,42,.08)}
.fld{display:grid;grid-template-columns:62px 1fr;align-items:center;gap:.45rem;padding:.28rem .42rem;border-radius:6px;border:1px dashed rgba(196,160,126,.65);background:rgba(255,255,255,.45);margin-bottom:.22rem;transition:all .35s}
.fld dt{font-family:var(--ff-m);font-size:.48rem;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-muted)}
.fld dd{font-family:var(--ff-m);font-size:.6rem;color:var(--ink-muted);opacity:.35;font-weight:500;transition:all .3s}
.fld.set{border-style:solid;border-color:var(--line);background:#fff}
.fld.set dd{opacity:1;color:var(--ink)}
.pill2{display:inline-flex;align-items:center;gap:.2rem;padding:.08rem .36rem;border-radius:999px;font-family:var(--ff-m);font-size:.46rem;font-weight:500;border:1px solid var(--line);color:var(--ink-muted);background:#fff;white-space:nowrap}
.pill2.ok{border-color:rgba(46,140,79,.35);background:rgba(46,140,79,.09);color:#1c6535}
.pill2.warn{border-color:rgba(192,120,32,.35);background:rgba(192,120,32,.1);color:var(--amber)}
.pill2.info{border-color:rgba(60,90,140,.32);background:rgba(60,90,140,.08);color:var(--blue)}
.term{border-radius:7px;background:#241811;padding:.42rem .5rem;font-family:var(--ff-m);font-size:.52rem;line-height:1.75;color:#d8c0a0;overflow:hidden}
.term .k{color:#e8a060}.term .v{color:#f0e0ca}.term .c{color:rgba(200,168,136,.45)}
.term .ln{opacity:0}
.term .ln.show{animation:rise .26s ease forwards}

/* ── HERO ── */
.wa-hero{padding:5rem 0 4rem;position:relative;isolation:isolate;overflow:hidden}
.wa-hero::before{content:'';position:absolute;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(ellipse 70% 55% at 80% 10%,rgba(162,74,42,.11),transparent),radial-gradient(ellipse 45% 55% at 5% 90%,rgba(255,215,140,.18),transparent)}
.wa-hero::after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 75% 75% at 68% 38%,black 0%,transparent 100%)}
.wa-hero__grid{display:grid;grid-template-columns:1fr 1.16fr;gap:3.2rem;align-items:center;position:relative;z-index:1}
.wa-hero__eyebrow{display:inline-flex;align-items:center;gap:.55rem;margin-bottom:.9rem}
.eyebrow-dot{width:8px;height:8px;border-radius:50%;background:var(--rust-500);animation:ping 2.2s ease-in-out infinite}
.eyebrow-text{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--rust-600)}
.wa-hero__h1{font-family:var(--ff-d);font-size:clamp(2.2rem,4.3vw,3.5rem);font-weight:400;line-height:1.08;letter-spacing:-.01em;margin-bottom:1.15rem}
.wa-hero__h1 em{font-style:italic;color:var(--rust-500)}
.wa-hero__lead{font-size:1rem;font-weight:300;color:var(--ink-soft);line-height:1.75;max-width:52ch;margin-bottom:1.8rem}
.wa-hero__demo{position:relative}
.demo-float{position:absolute;display:flex;align-items:center;gap:.4rem;font-size:.73rem;font-weight:600;color:#5a3d2e;background:rgba(255,248,232,.95);border:1.5px solid var(--line);border-radius:999px;padding:.42rem .82rem;box-shadow:0 6px 20px rgba(75,42,21,.12);white-space:nowrap;animation:floatY 3s ease-in-out infinite}
.demo-float svg{width:13px;height:13px;flex-shrink:0}
.demo-float-1{bottom:-1rem;left:-1.6rem}
.demo-float-2{top:1rem;right:-1.6rem;animation-delay:1.4s}

/* ── STATS / OVERVIEW ── */
.stats-strip{background:var(--dark-bg);display:grid;grid-template-columns:repeat(4,1fr);gap:1px}
.stat-item{text-align:center;padding:2rem 1rem;position:relative}
.stat-item:not(:last-child)::after{content:'';position:absolute;right:0;top:25%;bottom:25%;width:1px;background:rgba(255,255,255,.07)}
.stat-text{font-family:var(--ff-m);font-size:clamp(.95rem,1.7vw,1.3rem);font-weight:500;color:var(--rust-300);display:block;line-height:1.2;margin-bottom:.3rem}
.stat-label{font-size:.7rem;color:rgba(255,255,255,.38);letter-spacing:.06em;text-transform:uppercase}
.wa-problem{padding:4rem 0}
.wa-problem__card{display:grid;grid-template-columns:auto 1fr;gap:2.2rem;align-items:start;border:1.5px solid var(--line);border-radius:24px;padding:2.6rem 2.2rem;background:linear-gradient(148deg,rgba(255,245,228,.98),rgba(250,232,198,.9));box-shadow:0 16px 48px rgba(75,42,21,.09);opacity:0}
.wa-problem__card.in-view{animation:fadeUp .8s cubic-bezier(.22,.85,.44,1) forwards}
.wa-problem-icon{color:var(--rust-500);flex-shrink:0}
.wa-problem__text h2{font-family:var(--ff-d);font-size:clamp(1.55rem,2.7vw,2.2rem);font-weight:400;line-height:1.2;margin-bottom:.9rem}
.wa-problem__text p{color:var(--ink-soft);line-height:1.72;max-width:66ch;font-weight:300}
.wa-problem__text p+p{margin-top:.7rem}

/* ── FEATURE ROWS ── */
.feat-section{padding:3rem 0 2rem}
.feat-row{display:grid;grid-template-columns:1fr 1.14fr;gap:4rem;align-items:center;padding:4.5rem 0;border-bottom:1px solid var(--line)}
.feat-row:last-child{border-bottom:none}
.feat-row.reverse .feat-copy{order:2}.feat-row.reverse .feat-illu{order:1}
.feat-num{font-family:var(--ff-m);font-size:.6rem;letter-spacing:.14em;color:var(--rust-500);opacity:.5;display:block;margin-bottom:.4rem}
.feat-copy .sh2{margin-bottom:1rem}
