.fd-seam{position:relative;flex:0 0 1px;background:rgba(255,214,168,.3);z-index:6}
.fd-seam i{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);font-family:var(--ff-d);font-style:italic;font-size:1.55rem;color:var(--rust-500);box-shadow:0 12px 30px rgba(30,16,8,.45)}

@media(max-width:820px){
