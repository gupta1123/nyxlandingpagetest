/* ── founders diptych: attention shifts, the seam glides ── */
(()=>{
  const d=$('#diptych'); if(!d) return;
  const ps=[...d.querySelectorAll('.fd-panel')];
  const set=i=>ps.forEach((p,k)=>{p.classList.toggle('on',k===i);p.classList.toggle('dim',i!==null&&k!==i)});
  ps.forEach((p,i)=>{
    p.addEventListener('pointerenter',()=>set(i));
    p.addEventListener('focus',()=>set(i));
    p.addEventListener('click',()=>set(i));
    p.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();set(i)}});
  });
  d.addEventListener('pointerleave',()=>set(null));
})();
</script>
