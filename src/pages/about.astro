---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About Nyx Solution — Agentic AI for Business Operations" description="Nyx Solution builds human-governed agentic AI systems that understand business context and automate workflows across ERP, TallyPrime, SAP, and custom software.">
<style>
:root{
  --rust-100:#f5ebda;--rust-200:#e9c9a8;--rust-300:#da956a;--rust-400:#c56f45;
  --rust-500:#a24a2a;--rust-600:#85361c;--rust-700:#6b2a14;
  --sand-50:#fff8ed;--sand-100:#f5e8d4;
  --ink:#1f1a16;--ink-soft:#5f5148;--ink-muted:#7a5c4c;
  --surface:#fdf8ef;--line:rgba(216,200,179,.78);--line-mid:rgba(196,160,126,.45);
  --green:#2e8c4f;--amber:#c07820;--blue:#3c5a8c;--dark-bg:#2e1f19;
  --ff-d:'Instrument Serif',Georgia,serif;--ff-b:'Sora',sans-serif;--ff-m:'DM Mono',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:radial-gradient(circle at 92% 4%,rgba(162,74,42,.13) 0,rgba(162,74,42,0) 40%),radial-gradient(circle at 6% 18%,rgba(255,226,171,.26) 0,rgba(255,226,171,0) 38%),var(--surface);color:var(--ink);font-family:var(--ff-b);font-size:16px;line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.container{max-width:1180px;margin:0 auto;padding:0 2.4rem}
.narrow{max-width:820px;margin:0 auto;padding:0 2.4rem}
.eyebrow{font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--rust-500);display:block;margin-bottom:.55rem}
.sh2{font-family:var(--ff-d);font-size:clamp(1.8rem,3.2vw,2.5rem);font-weight:400;line-height:1.18;letter-spacing:-.01em;color:var(--ink)}
.sh2 em{font-style:italic;color:var(--rust-500)}
.btn{display:inline-block;font-size:.88rem;font-weight:600;border-radius:8px;padding:.66rem 1.5rem;transition:background .2s,transform .15s,box-shadow .2s}
.btn.primary{background:var(--rust-500);color:#fff;box-shadow:0 4px 18px rgba(162,74,42,.28)}
.btn.primary:hover{background:var(--rust-600);transform:translateY(-2px)}
.btn.ghost{border:1.5px solid var(--line-mid);color:var(--rust-600)}
.btn.ghost:hover{background:#fdf8ef;transform:translateY(-2px)}
.cta-row{display:flex;gap:.85rem;flex-wrap:wrap}.cta-row.center{justify-content:center}
@keyframes fadeUp{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(162,74,42,.5)}70%{box-shadow:0 0 0 9px rgba(162,74,42,0)}100%{box-shadow:0 0 0 0 rgba(162,74,42,0)}}
@keyframes blip{0%,100%{box-shadow:0 0 0 0 rgba(46,140,79,.45)}50%{box-shadow:0 0 0 5px rgba(46,140,79,0)}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.rv{opacity:0}.rv.in{animation:fadeUp .75s cubic-bezier(.22,.85,.44,1) both}

/* ── nav + ticker ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:.9rem 2.4rem;background:rgba(253,248,239,.93);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);transition:padding .3s}
nav.scrolled{padding-top:.6rem;padding-bottom:.6rem}
.nav-left{display:flex;align-items:center;gap:.7rem}
.nav-back{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:rgba(255,252,244,.7);color:var(--rust-600);display:inline-flex;align-items:center;justify-content:center;transition:all .2s}
.nav-back:hover{background:#fdf8ef;border-color:var(--rust-300);transform:translateY(-1px)}
.nav-logo{font-family:var(--ff-d);font-size:1.3rem;font-style:italic;color:var(--rust-600)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{font-size:.83rem;color:var(--ink-soft);transition:color .2s}
.nav-links a:hover{color:var(--rust-500)}
.nav-cta{font-size:.83rem;font-weight:600;padding:.46rem 1.15rem;border-radius:8px;background:var(--rust-500);color:#fff;transition:all .2s}
.nav-cta:hover{background:var(--rust-600);transform:translateY(-1px)}
.ticker-wrap{margin-top:63px;overflow:hidden;background:linear-gradient(90deg,#f3e6cf,#ecd8b8);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:.5rem 0}
.ticker{display:flex;width:max-content;white-space:nowrap;animation:marquee 30s linear infinite}
.ticker-item{font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-600);padding:0 2.2rem;flex-shrink:0}
.ticker-item::after{content:'·';margin-left:2.2rem;color:var(--rust-400)}

/* ══════════════════════════════════════════════════
   SHARED 3D SCENE — straight-on camera, real depth.
   Elements live at different Z, cast shadows on each
   other, and travel through Z as work happens.
   ══════════════════════════════════════════════════ */
.scene{perspective:1500px;perspective-origin:50% 40%}
.slab{position:relative;transform-style:preserve-3d;border-radius:16px;background:#fffdf8;
  border:1px solid var(--line-mid);
  box-shadow:0 34px 74px rgba(75,42,21,.15),0 6px 16px rgba(75,42,21,.07),inset 0 1px 0 #fff}
.slab::after{content:'';position:absolute;inset:6px -6px -10px 6px;border-radius:16px;z-index:-1;
  background:linear-gradient(180deg,#e6d6bd,#d8c4a6);transform:translateZ(-22px)}
.slab-bar{display:flex;align-items:center;gap:.6rem;padding:.6rem .85rem;background:var(--sand-100);border-bottom:1px solid var(--line);border-radius:15px 15px 0 0}
.slab-bar b{font-family:var(--ff-m);font-size:.68rem;font-weight:600;color:var(--ink)}
.slab-bar .sub{font-family:var(--ff-m);font-size:.6rem;color:var(--ink-muted)}
.tagi{margin-left:auto;font-family:var(--ff-m);font-size:.55rem;font-weight:600;letter-spacing:.06em;padding:.14rem .48rem;border-radius:999px;background:rgba(162,74,42,.09);color:var(--rust-600);border:1px solid rgba(162,74,42,.18)}
.tagi.live{background:rgba(46,140,79,.09);color:#1c6535;border-color:rgba(46,140,79,.22);display:flex;align-items:center;gap:.3rem}
.tagi.live i{width:5px;height:5px;border-radius:50%;background:var(--green);animation:blip 2s ease-in-out infinite}
.slab-body{padding:.85rem .9rem}

/* paper — used wherever a real document appears */
.paper{background:linear-gradient(178deg,#fdfaf3,#f6f0e4);border-radius:4px;color:#2a2119;
  box-shadow:0 14px 30px rgba(60,38,18,.24),0 2px 4px rgba(60,38,18,.14),inset 0 1px 0 #fff;
  border:1px solid #e4dac8}

/* ── HERO ── */
.ab-hero{padding:3.4rem 0 3rem;position:relative}
.ab-hero__grid{display:grid;grid-template-columns:1fr 1.14fr;gap:3.4rem;align-items:center}
.ab-hero__eyebrow{display:inline-flex;align-items:center;gap:.55rem;margin-bottom:.9rem}
.eyebrow-dot{width:8px;height:8px;border-radius:50%;background:var(--rust-500);animation:ping 2.2s ease-in-out infinite}
.ab-hero__h1{font-family:var(--ff-d);font-size:clamp(2.3rem,4.5vw,3.7rem);font-weight:400;line-height:1.08;letter-spacing:-.01em;margin-bottom:1.1rem}
.ab-hero__h1 em{font-style:italic;color:var(--rust-500)}
.ab-hero__lead{font-size:1rem;font-weight:300;color:var(--ink-soft);line-height:1.75;max-width:50ch;margin-bottom:1.7rem}

.intake{position:relative;min-height:392px}
.board{position:relative;transform:translateZ(0)}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin-bottom:.65rem}
.tile{border:1px solid var(--line);border-radius:9px;background:#fff;padding:.5rem .6rem}
.tile b{display:block;font-family:var(--ff-m);font-size:1.1rem;font-weight:500;line-height:1.15}
.tile span{font-family:var(--ff-m);font-size:.48rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted)}
.tile.hold b{color:var(--amber)}.tile.post b{color:var(--rust-500)}
.feed{border:1px solid var(--line);border-radius:9px;background:#fff;overflow:hidden}
.feed-h{display:flex;justify-content:space-between;padding:.38rem .6rem;border-bottom:1px solid rgba(216,200,179,.5);font-family:var(--ff-m);font-size:.48rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted)}
.feed-wrap{height:118px;overflow:hidden;position:relative}
.feed-scroll{position:absolute;left:0;right:0;bottom:0;padding:.2rem .6rem .4rem}
.frow{display:grid;grid-template-columns:auto auto 1fr;align-items:baseline;gap:.5rem;padding:.22rem 0;font-family:var(--ff-m);font-size:.57rem;line-height:1.5;color:var(--ink-soft);border-bottom:1px dashed rgba(216,200,179,.45);animation:rise .34s cubic-bezier(.22,.85,.44,1) both}
.frow .t{font-size:.5rem;color:var(--ink-muted);white-space:nowrap}
.frow s{width:5px;height:5px;border-radius:50%;background:var(--blue);text-decoration:none;transform:translateY(-1px)}
.frow b{font-weight:400;color:var(--ink)}
.frow.ok s{background:var(--green)}.frow.hold s{background:var(--amber)}.frow.post s{background:var(--rust-500)}

/* the physical intake stack, floating in front of the board */
.stack{position:absolute;right:-14px;bottom:-26px;width:190px;height:150px;transform-style:preserve-3d;pointer-events:none}
.doc{position:absolute;inset:0;padding:9px 10px;transform-style:preserve-3d;
  transition:transform .8s cubic-bezier(.3,.8,.3,1),opacity .6s ease}
.doc h6{font-family:var(--ff-m);font-size:.5rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8a6b4a;border-bottom:1px solid #e0d5c1;padding-bottom:3px;margin-bottom:5px;display:flex;justify-content:space-between}
.doc i{display:block;height:3px;border-radius:2px;background:#e0d6c4;margin-bottom:4px}
.doc i:nth-child(3){width:82%}.doc i:nth-child(5){width:64%}.doc i:nth-child(7){width:74%}
.doc .amt{font-family:var(--ff-m);font-size:.56rem;color:#6b4b2c;text-align:right;margin-top:6px;border-top:1px solid #e0d5c1;padding-top:4px}
.doc.d3{transform:translate3d(0,0,10px) rotate(-4deg)}
.doc.d2{transform:translate3d(5px,-7px,26px) rotate(2.4deg)}
.doc.d1{transform:translate3d(-3px,-15px,42px) rotate(-1.4deg)}
.doc.lift{transform:translate3d(-46px,-96px,250px) rotate(-7deg) scale(1.04);opacity:0}

/* ── stats strip ── */
.stats-strip{background:var(--dark-bg);display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:1.5rem}
.stat-item{text-align:center;padding:2rem 1rem;position:relative}
.stat-item:not(:last-child)::after{content:'';position:absolute;right:0;top:25%;bottom:25%;width:1px;background:rgba(255,255,255,.07)}
.stat-text{font-family:var(--ff-m);font-size:clamp(.95rem,1.7vw,1.35rem);font-weight:500;color:var(--rust-300);display:block;line-height:1.2;margin-bottom:.3rem}
.stat-label{font-size:.7rem;color:rgba(255,255,255,.38);letter-spacing:.06em;text-transform:uppercase}

/* ── origin ── */
.ab-origin{padding:4rem 0}
.ab-origin__card{display:grid;grid-template-columns:auto 1fr;gap:2.2rem;align-items:start;border:1.5px solid var(--line);border-radius:24px;padding:2.6rem 2.2rem;background:linear-gradient(148deg,rgba(255,245,228,.98),rgba(250,232,198,.9));box-shadow:0 16px 48px rgba(75,42,21,.09)}
.ab-origin-icon{color:var(--rust-500);flex-shrink:0}
.ab-origin__text h2{font-family:var(--ff-d);font-size:clamp(1.55rem,2.7vw,2.2rem);font-weight:400;line-height:1.2;margin-bottom:.9rem}
.ab-origin__text p{color:var(--ink-soft);line-height:1.72;max-width:66ch;font-weight:300}
.ab-origin__text p+p{margin-top:.7rem}

/* ── feature rows ── */
.feat-section{padding:2rem 0}
.feat-row{display:grid;grid-template-columns:1fr 1.08fr;gap:4rem;align-items:center;padding:4.4rem 0;border-bottom:1px solid var(--line)}
.feat-row:last-child{border-bottom:none}
.feat-row.reverse .feat-copy{order:2}.feat-row.reverse .feat-illu{order:1}
.feat-copy .sh2{margin-bottom:1rem}
.feat-copy p{font-size:.95rem;font-weight:300;color:var(--ink-soft);line-height:1.75;margin-bottom:.9rem}
.bullet-list{list-style:none;display:grid;gap:.5rem;margin-top:1.1rem}
.bullet-list li{position:relative;padding-left:1.1rem;font-size:.88rem;color:var(--ink-soft)}
.bullet-list li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--rust-400)}

/* ── 1 · DISCOVERY WORKSHEET + STICKY NOTES ── */
.sheet-scene{position:relative;padding:14px 30px 26px 14px}
.wsheet{width:100%;border-collapse:collapse;font-family:var(--ff-m)}
.wsheet th{font-size:.52rem;letter-spacing:.1em;text-transform:uppercase;color:#9a7d5c;text-align:left;font-weight:500;padding:0 .4rem .34rem;border-bottom:1px solid #ddd0b8}
.wsheet td{padding:.42rem .4rem;border-bottom:1px solid #eae0cc;font-size:.62rem;color:#5c4d3d;vertical-align:middle}
.wsheet tr{opacity:0}.wsheet tr.show{animation:rise .34s cubic-bezier(.22,.85,.44,1) forwards}
.wsheet .st{color:#2f261d;font-size:.66rem;display:block}
.wsheet .who{color:#8f7a62;font-size:.56rem}
.notes{position:absolute;inset:0;pointer-events:none;transform-style:preserve-3d}
.note{position:absolute;right:6px;width:74px;padding:.3rem 0;text-align:center;
  font-family:var(--ff-m);font-size:.5rem;font-weight:700;letter-spacing:.09em;
  box-shadow:0 10px 22px rgba(60,38,18,.26),0 2px 3px rgba(60,38,18,.16);
  opacity:0;transform:translate3d(140px,-30px,340px) rotate(16deg);
  transition:transform .7s cubic-bezier(.28,.9,.3,1),opacity .35s ease}
.note.on{opacity:1}
.note.a{background:#f0c9b0;color:#7a3318;border:1px solid #dfb094}
.note.r{background:#c3d0e4;color:#2f4a76;border:1px solid #a9bbd6}
.note.h{background:#f3dca6;color:#7e5410;border:1px solid #e0c584}
.wfoot{margin-top:.75rem;padding-top:.6rem;border-top:1px solid #ddd0b8;display:flex;align-items:center;gap:.7rem;flex-wrap:wrap}
.splitbar{flex:1;min-width:110px;height:7px;border-radius:999px;overflow:hidden;display:flex;background:rgba(162,74,42,.07)}
.splitbar i{height:100%;width:0;transition:width .9s cubic-bezier(.22,.85,.44,1)}
.splitbar .sa{background:var(--rust-400)}.splitbar .sr{background:var(--blue);opacity:.72}.splitbar .sh{background:var(--amber)}
.wfoot span{font-family:var(--ff-m);font-size:.56rem;color:#8a7358;white-space:nowrap}
.wfoot b{color:#3a2f24;font-weight:500}

/* ── 2 · RELEASE PIPELINE ── */
.stage{display:grid;grid-template-columns:20px 1fr auto;align-items:center;gap:.6rem;padding:.46rem .55rem;border-radius:9px;border:1px solid transparent;margin-bottom:3px;transform-style:preserve-3d;transition:background .35s,border-color .35s,transform .5s cubic-bezier(.3,.9,.3,1),box-shadow .5s}
.stage .ic{width:16px;height:16px;border-radius:50%;border:1.5px solid var(--line-mid);display:grid;place-items:center;font-size:.48rem;color:transparent;background:#fff;transition:all .35s}
.stage b{font-size:.72rem;font-weight:500;color:var(--ink-soft);transition:color .3s}
.stage .m{font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted);opacity:0;transition:opacity .4s}
.stage.done .ic{background:var(--green);border-color:var(--green);color:#fff}
.stage.done b{color:var(--ink)}.stage.done .m{opacity:1;color:#1c6535}
.stage.run .ic{border-color:var(--rust-400);border-right-color:transparent;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.stage.run b{color:var(--ink)}.stage.run .m{opacity:1}
.stage.lock{opacity:.42}
.gate{margin:.55rem 0 .3rem;padding:.6rem .65rem;border-radius:11px;border:1px solid rgba(192,120,32,.35);
  background:linear-gradient(180deg,#fff6e6,#fdedd4);display:flex;align-items:center;gap:.65rem;
  transform:translateZ(0) translateY(6px);opacity:0;
  box-shadow:0 2px 6px rgba(75,42,21,.08);
  transition:transform .6s cubic-bezier(.3,.9,.3,1),opacity .45s,box-shadow .6s,border-color .4s,background .4s}
.gate.on{opacity:1;transform:translateZ(70px) translateY(0);box-shadow:0 26px 46px rgba(75,42,21,.2)}
.gate.ok{border-color:rgba(46,140,79,.4);background:linear-gradient(180deg,#f2fbf3,#e6f5ea)}
.gate .txt{flex:1;min-width:0}
.gate .txt b{display:block;font-size:.68rem;font-weight:600;color:var(--ink)}
.gate .txt span{font-family:var(--ff-m);font-size:.54rem;color:var(--ink-muted)}
.gbtn{position:relative;overflow:hidden;font-family:var(--ff-m);font-size:.55rem;font-weight:600;letter-spacing:.05em;padding:.38rem .72rem;border-radius:7px;background:var(--amber);color:#fff;white-space:nowrap;box-shadow:0 4px 10px rgba(192,120,32,.35);transition:transform .2s cubic-bezier(.34,1.5,.64,1),box-shadow .2s,background .3s}
.gbtn.hot{transform:translateY(-2px);box-shadow:0 8px 18px rgba(192,120,32,.42)}
.gbtn.press{transform:translateY(1px) scale(.97)}
.gbtn.done{background:var(--green);box-shadow:0 4px 10px rgba(46,140,79,.32)}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.65);transform:translate(-50%,-50%) scale(0);pointer-events:none}
.rip.go{animation:rp .55s ease-out forwards}
@keyframes rp{to{transform:translate(-50%,-50%) scale(14);opacity:0}}
.cursor{position:absolute;width:17px;height:17px;z-index:60;opacity:0;pointer-events:none;filter:drop-shadow(0 4px 8px rgba(60,38,18,.4));transition:transform .95s cubic-bezier(.33,.9,.28,1),opacity .3s}
.cursor.on{opacity:1}
.cursor.tap{transform:var(--pos) scale(.85)!important;transition:transform .11s ease}

/* ── 3 · AUTONOMY POLICY ── */
.prow{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.7rem;padding:.44rem .5rem;border-radius:9px;border-bottom:1px solid rgba(216,200,179,.5);opacity:0;transform-style:preserve-3d;
  transition:background .4s,transform .55s cubic-bezier(.3,.9,.3,1),box-shadow .55s}
.prow.show{animation:rise .32s cubic-bezier(.22,.85,.44,1) forwards}
.prow:last-of-type{border-bottom:none}
.prow.edit{background:#fff4e0;border-bottom-color:transparent;transform:translateZ(56px);box-shadow:0 20px 40px rgba(75,42,21,.18)}
.prow .lbl{font-size:.71rem;color:var(--ink);line-height:1.35}
.prow .cond{display:block;font-family:var(--ff-m);font-size:.54rem;color:var(--ink-muted);margin-top:.08rem}
.mode{font-family:var(--ff-m);font-size:.51rem;font-weight:600;letter-spacing:.07em;padding:.2rem .5rem;border-radius:999px;white-space:nowrap;transition:all .4s}
.mode.auto{background:rgba(46,140,79,.1);color:#1c6535;border:1px solid rgba(46,140,79,.25)}
.mode.appr{background:rgba(192,120,32,.12);color:var(--amber);border:1px solid rgba(192,120,32,.3)}
.mode.blk{background:rgba(162,74,42,.1);color:var(--rust-600);border:1px solid rgba(162,74,42,.25)}
.numfield{display:inline-block;font-family:var(--ff-m);padding:0 .22rem;border-radius:3px;border-bottom:1.5px solid transparent;transition:all .3s}
.numfield.editing{background:rgba(192,120,32,.2);border-bottom-color:var(--amber)}
.caret{display:inline-block;width:1px;height:.75em;background:var(--amber);vertical-align:-1px;margin-left:1px;opacity:0}
.caret.on{animation:blink .8s step-end infinite}
@keyframes blink{50%{opacity:1}}
.saved{display:flex;align-items:center;gap:.35rem;margin-top:.6rem;padding-top:.55rem;border-top:1px solid var(--line);font-family:var(--ff-m);font-size:.55rem;color:var(--ink-muted);opacity:0;transition:opacity .4s}
.saved.on{opacity:1;color:#1c6535}
.saved i{width:5px;height:5px;border-radius:50%;background:var(--green)}

/* ── 4 · REVIEWER — layered evidence ── */
.review{position:relative;min-height:330px;transform-style:preserve-3d}
.stmt{padding:.65rem .7rem}
.stmt .rv-l{font-family:var(--ff-m);font-size:.48rem;letter-spacing:.13em;text-transform:uppercase;color:#9a7d5c;margin-bottom:.34rem}
.src{font-family:var(--ff-m);font-size:.58rem;line-height:1.85;color:#5c4d3d;word-break:break-all}
.src mark{background:transparent;color:inherit;padding:1px 2px;border-radius:2px;transition:background .4s,color .4s}
.src mark.lit{background:rgba(192,120,32,.32);color:#2f261d}
.srcmeta{font-family:var(--ff-m);font-size:.5rem;color:#9a7d5c;margin-top:.4rem;border-top:1px solid #e4dac8;padding-top:.35rem}
.rules{margin-top:.5rem}
.rule{display:flex;align-items:center;gap:.4rem;font-family:var(--ff-m);font-size:.55rem;color:#5c4d3d;padding:.14rem 0;opacity:0}
.rule.show{animation:rise .3s cubic-bezier(.22,.85,.44,1) forwards}
.rule s{width:11px;height:11px;border-radius:50%;background:rgba(46,140,79,.16);border:1px solid rgba(46,140,79,.32);text-decoration:none;flex-shrink:0;position:relative}
