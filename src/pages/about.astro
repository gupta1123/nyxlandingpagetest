      const top=docs[order[0]];
      top.classList.add('lift');
      await sleep(760);
      order.push(order.shift());
      top.classList.remove('lift');
      order.forEach((idx,pos)=>{docs[idx].classList.remove('d1','d2','d3');docs[idx].classList.add(cls[pos])});
      await sleep(2600);
    }
  })();
})();

